local URL = "https://raw.githubusercontent.com/Kai090898/Kai-script/refs/heads/main/%E6%9C%B5%E6%8B%89%E6%98%AF%E7%94%B2"

local ok, err = pcall(function()
    local src = game:HttpGet(URL)
    print("下載長度：", #src)
    local fn, cerr = loadstring(src)
    if not fn then
        error("語法錯誤：" .. tostring(cerr), 0)
    end
    fn()
end)

if not ok then
    warn("[診斷] " .. tostring(err))
    if setclipboard then setclipboard(tostring(err)) end
end
