--  櫻 mini game AFK（獨立的第二個介面）
--  功能：自動撿花（走過去）、自動翻機器人
--  介面庫與主腳本共用同一個「卡依ui」，但會開成獨立的第二個視窗
-- ====================================================================
local env = (getgenv and getgenv()) or _G

-- 已經開著的話，直接把視窗叫出來就好（不要重新建立，免得掛機狀態被重設）
if env.KaiSakuraAFK and env.KaiSakuraAFK.alive() then
    env.KaiSakuraAFK.show()
    return
end

local UI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Kai090898/Kai-slap-battles-script/refs/heads/main/%E5%8D%A1%E4%BE%9Dui"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local function notify(title, content, duration)
    UI:Notify({Title = title, Content = content, Duration = duration or 3})
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- 這個介面沒有英文切換，這兩個是給下面共用的程式用的
local langItems = {}
local useEnglish = false

-- 掛機區與翻機器人之間互相呼叫用
local FarmAPI = {}

-- ===== 穿透（Noclip）：自動撿花啟動時會自動打開 =====
local noclipOn = false
local noclipParts = {}

local function restoreNoclip()
    for p in pairs(noclipParts) do
        if p.Parent then
            p.CanCollide = true
        end
    end
    noclipParts = {}
end

RunService.Stepped:Connect(function()
    if not noclipOn then
        return
    end
    local char = LocalPlayer.Character
    if not char then
        return
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            noclipParts[p] = true
            p.CanCollide = false
        end
    end
end)

-- 讓下面的程式可以用 tNoclip:Set(true/false)
local tNoclip = {}
function tNoclip:Set(v)
    noclipOn = v and true or false
    if not noclipOn then
        restoreNoclip()
    end
end

-- ===== 設定存檔（只存這個介面自己的設定）=====
local CONFIG_FILE = "KaiScript_SakuraAFK.json"
local reg = {}

local function regToggle(key, el, get)
    table.insert(reg, {key = key, kind = "toggle", el = el, get = get})
end
local function regNumber(key, el, get, set)
    table.insert(reg, {key = key, kind = "number", el = el, get = get, set = set})
end
local function regDropdown(key, el, get, set)
    table.insert(reg, {key = key, kind = "dropdown", el = el, get = get, set = set})
end
local function regText(key, el, get, set)
    table.insert(reg, {key = key, kind = "text", el = el, get = get, set = set})
end

local function saveConfig()
    if not (writefile and HttpService) then
        notify("無法儲存", "這個執行器不支援檔案功能")
        return
    end
    local data = {}
    for _, r in ipairs(reg) do
        data[r.key] = r.get()
    end
    local ok, err = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    if ok then
        notify("已儲存", "櫻 mini game AFK 的設定已存檔")
    else
        notify("儲存失敗", tostring(err))
    end
end

local function loadConfig(quiet)
    if not (isfile and readfile) or not isfile(CONFIG_FILE) then
        if not quiet then
            notify("沒有存檔", "請先按「儲存設定」")
        end
        return
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(data) ~= "table" then
        return
    end
    -- 先套用數字、選項和文字（地塊要先於掛機點），再套用開關
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil then
            if r.kind == "number" and type(v) == "number" then
                pcall(function() r.set(v) r.el:Set(tostring(v)) end)
            elseif r.kind == "dropdown" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set({v}) end)
            elseif r.kind == "text" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set(v) end)
            end
        end
    end
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil and r.kind == "toggle" and type(v) == "boolean" then
            pcall(function() r.el:Set(v) end)
        end
    end
    if not quiet then
        notify("已載入", "設定已套用")
    end
end

