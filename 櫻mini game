AfkTab:CreateSection("掛機")

do
    local petalOn = false
    local petalRange = 120
    local goHomeOn = true                            -- 撿完花走回掛機點
    local homePos = Vector3.new(652, 4, -598)        -- 掛機區的重生點
    local zoneName = "全部"
    local onHomeChanged = function() end             -- 掛機點被自動換掉時，更新輸入框（稍後指定）
    local skipUntil = setmetatable({}, {__mode = "k"})  -- 撿不到的花先跳過一陣子

    -- ===== 掛機區範圍（四個角量出來的座標）=====
    local AREA = {minX = 587, maxX = 1001, minZ = -693, maxZ = -495}
    local EDGE_PAD = 2        -- 角色離邊界至少保持的距離（格）
    Move.area, Move.pad = AREA, EDGE_PAD

    -- 位置是否在掛機區內（超出去的花不撿）
    local function inArea(pos)
        return pos.X >= AREA.minX + 1 and pos.X <= AREA.maxX - 1
            and pos.Z >= AREA.minZ + 1 and pos.Z <= AREA.maxZ - 1
    end

    -- 四面牆（只在你自己的畫面裡存在，用來擋住不要掉出去）
    local wallFolder = nil

    local function clearWalls()
        if wallFolder then
            wallFolder:Destroy()
            wallFolder = nil
        end
    end

    local function buildWalls()
        clearWalls()
        wallFolder = Instance.new("Folder")
        wallFolder.Name = "KaiWalls"
        wallFolder.Parent = workspace

        local T, H, Y = 4, 60, 20   -- 厚度、高度、中心高度
        local cx, cz = (AREA.minX + AREA.maxX) / 2, (AREA.minZ + AREA.maxZ) / 2
        local w, d = AREA.maxX - AREA.minX, AREA.maxZ - AREA.minZ

        local function wall(size, pos)
            local part = Instance.new("Part")
            part.Anchored = true
            part.CanCollide = true
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.Material = Enum.Material.SmoothPlastic
            part.Color = Color3.fromRGB(180, 220, 255)
            part.Transparency = 0.85
            part.Size = size
            part.Position = pos
            part.Parent = wallFolder
        end

        -- 牆的內側剛好貼在區域邊界上
        wall(Vector3.new(w + 2 * T, H, T), Vector3.new(cx, Y, AREA.minZ - T / 2))
        wall(Vector3.new(w + 2 * T, H, T), Vector3.new(cx, Y, AREA.maxZ + T / 2))
        wall(Vector3.new(T, H, d), Vector3.new(AREA.minX - T / 2, Y, cz))
        wall(Vector3.new(T, H, d), Vector3.new(AREA.maxX + T / 2, Y, cz))
    end

    -- ===== 地塊選擇 =====
    local ZONES = {
        ["草地區"] = {minX = 717, maxX = 1001, minZ = -693, maxZ = -495, home = Vector3.new(824, 1, -581)},
        ["木板區"] = {minX = 587, maxX = 717, minZ = -693, maxZ = -496, home = Vector3.new(652, 4, -598)},
        ["全部"] = {minX = 587, maxX = 1001, minZ = -693, maxZ = -495},  -- 掛機點自己調
    }

    local function setZone(name)
        local z = ZONES[name]
        if not z then
            return
        end
        zoneName = name
        AREA.minX, AREA.maxX, AREA.minZ, AREA.maxZ = z.minX, z.maxX, z.minZ, z.maxZ
        if z.home then
            homePos = z.home  -- 草地區、木板區的掛機點自動換成預設的
            onHomeChanged()
        end
        if petalOn then
            buildWalls()  -- 自動撿花開著時，牆也跟著換位置
        end
    end

    -- ===== 避開傳送陣 =====
    local HAZARD_MARGIN = 3.5   -- 離傳送陣邊緣至少保持的距離
    local hazards = {}
    local lastHazardScan = 0

    local function scanHazards()
        if tick() - lastHazardScan < 8 then
            return
        end
        lastHazardScan = tick()
        local list = {}
        local scopes = {}
        for _, name in ipairs({"SakuraRestArea", "RobotTreasureHunt"}) do
            local f = workspace:FindFirstChild(name)
            if f then
                table.insert(scopes, f)
            end
        end
        if #scopes == 0 then
            scopes = {workspace}
        end
        for _, scope in ipairs(scopes) do
            for _, v in ipairs(scope:GetDescendants()) do
                if v:IsA("BasePart") and v.Name:lower():find("teleport") then
                    table.insert(list, v)
                end
            end
        end
        hazards = list
    end

    local function toLocal2(part, pos)
        local p = part.CFrame:PointToObjectSpace(pos)
        return Vector2.new(p.X, p.Z)
    end

    local function toWorld(part, v2, y)
        local w = part.CFrame:PointToWorldSpace(Vector3.new(v2.X, 0, v2.Y))
        return Vector3.new(w.X, y, w.Z)
    end

    -- 線段 a→b 是否穿過以原點為中心、半寬 hx、半長 hz 的矩形
    local function segHits(a, b, hx, hz)
        local d = b - a
        local t0, t1 = 0, 1
        local axes = {{a.X, d.X, hx}, {a.Y, d.Y, hz}}
        for _, ax in ipairs(axes) do
            local ao, dd, h = ax[1], ax[2], ax[3]
            if math.abs(dd) < 1e-6 then
                if ao < -h or ao > h then
                    return false
                end
            else
                local ta, tb = (-h - ao) / dd, (h - ao) / dd
                if ta > tb then
                    ta, tb = tb, ta
                end
                t0 = math.max(t0, ta)
                t1 = math.min(t1, tb)
                if t0 > t1 then
                    return false
                end
            end
        end
        return true
    end

    local function hazardHalf(part)
        return part.Size.X / 2 + HAZARD_MARGIN, part.Size.Z / 2 + HAZARD_MARGIN
    end

    -- 這個位置是否在傳送陣（含安全距離）範圍內
    local function inHazard(pos)
        for _, h in ipairs(hazards) do
            if h.Parent then
                local hx, hz = hazardHalf(h)
                local a = toLocal2(h, pos)
                if math.abs(a.X) < hx and math.abs(a.Y) < hz then
                    return true
                end
            end
        end
        return false
    end

    -- 從 from 走到 to，如果會踩到傳送陣，回傳要先繞過去的中繼點；不用繞就回傳 nil
    local function detour(from, to)
        scanHazards()
        for _, h in ipairs(hazards) do
            if h.Parent then
                local hx, hz = hazardHalf(h)
                local a, b = toLocal2(h, from), toLocal2(h, to)
                local y = from.Y

                -- 已經站在危險範圍裡：先往最近的邊走出去
                if math.abs(a.X) < hx and math.abs(a.Y) < hz then
                    local dx, dz = hx - math.abs(a.X), hz - math.abs(a.Y)
                    local out
                    if dx < dz then
                        out = Vector2.new((a.X >= 0 and 1 or -1) * (hx + 1), a.Y)
                    else
                        out = Vector2.new(a.X, (a.Y >= 0 and 1 or -1) * (hz + 1))
                    end
                    return toWorld(h, out, y)
                end

                local ehx, ehz = hx - 0.05, hz - 0.05
                if segHits(a, b, ehx, ehz) then
                    local c = {
                        Vector2.new(-hx, -hz), Vector2.new(hx, -hz),
                        Vector2.new(hx, hz), Vector2.new(-hx, hz),
                    }
                    local best, bestLen
                    local function consider(first, pts)
                        local prev, len = a, 0
                        for _, q in ipairs(pts) do
                            if segHits(prev, q, ehx, ehz) then
                                return
                            end
                            len += (q - prev).Magnitude
                            prev = q
                        end
                        if segHits(prev, b, ehx, ehz) then
                            return
                        end
                        len += (b - prev).Magnitude
                        if not bestLen or len < bestLen then
                            best, bestLen = first, len
                        end
                    end
                    for i = 1, 4 do
                        consider(c[i], {c[i]})
                        consider(c[i], {c[i], c[i % 4 + 1]})
                    end
                    if best then
                        return toWorld(h, best, y)
                    end
                end
            end
        end
        return nil
    end

    FarmAPI.detour = detour
    FarmAPI.inHazard = inHazard

    -- 預測花最後會落在哪裡：往正下方打射線找地面，
    -- 如果花是會受重力往下掉的，再把水平的飄移一起算進去
    local landParams = RaycastParams.new()
    landParams.FilterType = Enum.RaycastFilterType.Exclude

    local function landingPoint(petal)
        local pos = petal.Position
        local ignore = {}
        if LocalPlayer.Character then
            table.insert(ignore, LocalPlayer.Character)
        end
        local folder = workspace:FindFirstChild("FlowerPetals")
        if folder then
            table.insert(ignore, folder)
        end
        landParams.FilterDescendantsInstances = ignore

        local hit = workspace:Raycast(pos, Vector3.new(0, -1000, 0), landParams)
        local groundY = hit and hit.Position.Y or pos.Y
        local h = math.max(pos.Y - groundY, 0)
        local x, z = pos.X, pos.Z

        if not petal.Anchored and h > 1 then
            local v = petal.AssemblyLinearVelocity
            local g = workspace.Gravity
            local t = (v.Y + math.sqrt(v.Y * v.Y + 2 * g * h)) / g
            t = math.clamp(t, 0, 6)
            x += v.X * t
            z += v.Z * t
        end
        return Vector3.new(x, groundY, z), h
    end

    -- 找範圍內最近的花（用預測的落地點算距離）
    local function nearestPetal(root)
        local folder = workspace:FindFirstChild("FlowerPetals")
        if not folder then
            return nil
        end
        scanHazards()
        local best, bestD
        for _, p in ipairs(folder:GetDescendants()) do
            if p:IsA("BasePart") and p.Name == "Petal" and p.Parent
                and (skipUntil[p] or 0) < tick() then
                local land = landingPoint(p)
                if inArea(land) and not inHazard(land) then
                    local off = land - root.Position
                    local flat = Vector3.new(off.X, 0, off.Z).Magnitude
                    if flat <= petalRange and (not bestD or flat < bestD) then
                        best, bestD = p, flat
                    end
                end
            end
        end
        return best
    end

    -- 走到花的落地點等它：一直更新預測位置，卡住就跳
    local function walkTo(hum, root, petal)
        local t0 = tick()
        local lastPos, lastCheck = root.Position, tick()
        local reachedAt = nil
        while petalOn and petal.Parent and tick() - t0 < 12 and hum.Health > 0 do
            local land, h = landingPoint(petal)

            -- 落地點如果在傳送陣範圍內就放棄這朵
            if inHazard(land) or not inArea(land) then
                break
            end

            -- 如果直線會踩到傳送陣，先走到繞路的中繼點
            local wp = detour(root.Position, land)
            Move.to(hum, root, wp or land, true)

            local off = land - root.Position
            local flat = Vector3.new(off.X, 0, off.Z).Magnitude
            if flat < 2.5 and h < 4 then
                -- 花已經快落地了，站在那裡超過 1.5 秒還沒撿到，就放棄這朵
                reachedAt = reachedAt or tick()
                if tick() - reachedAt > 1.5 then
                    break
                end
            else
                reachedAt = nil
            end

            -- 卡住偵測：0.7 秒幾乎沒移動就跳一下（站著等花落下時不算）
            if tick() - lastCheck > 0.7 then
                if (root.Position - lastPos).Magnitude < 1 and flat > 3 then
                    hum.Jump = true
                end
                lastPos, lastCheck = root.Position, tick()
            end
            task.wait(0.1)
        end
        if petal.Parent then
            skipUntil[petal] = tick() + 5  -- 沒撿掉的花，5 秒內不再追
        end
    end

    -- 走回掛機點；途中如果範圍內出現花，就立刻停下來（回到主迴圈去追花）
    local function walkHome(hum, root)
        local t0 = tick()
        local lastPos, lastCheck = root.Position, tick()
        while petalOn and goHomeOn and hum.Health > 0 and tick() - t0 < 30 do
            local off = homePos - root.Position
            local flat = Vector3.new(off.X, 0, off.Z).Magnitude
            if flat < 3 then
                break
            end
            if nearestPetal(root) then
                return
            end

            local wp = detour(root.Position, homePos)
            Move.to(hum, root, wp or homePos, true)

            if tick() - lastCheck > 0.7 then
                if (root.Position - lastPos).Magnitude < 1 then
                    hum.Jump = true
                end
                lastPos, lastCheck = root.Position, tick()
            end
            task.wait(0.15)
        end
    end

    task.spawn(function()
        local wasOn = false
        while true do
            if petalOn then
                wasOn = true
                local root = getRoot()
                local hum = getHumanoid()
                if root and hum and hum.Health > 0 and not hum.Sit then
                    local petal = nearestPetal(root)
                    if petal then
                        pcall(walkTo, hum, root, petal)
                    elseif goHomeOn then
                        local off = homePos - root.Position
                        if Vector3.new(off.X, 0, off.Z).Magnitude >= 3 then
                            pcall(walkHome, hum, root)
                        else
                            Move.stop(hum, root)
                            task.wait(0.3)
                        end
                    else
                        Move.stop(hum, root)
                        task.wait(0.3)
                    end
                else
                    Move.stop(hum, root)
                    task.wait(0.5)
                end
                task.wait()
            else
                if wasOn then
                    wasOn = false
                    local root, hum = getRoot(), getHumanoid()
                    if root and hum then
                        Move.stop(hum, root)  -- 停下來
                    end
                end
                task.wait(0.3)
            end
        end
    end)

    local dZone = AfkTab:CreateDropdown({
        Name = "地塊選擇",
        Options = {"草地區", "木板區", "全部"},
        CurrentOption = {zoneName},
        Callback = function(opt)
            local z = type(opt) == "table" and opt[1] or opt
            if ZONES[z] then
                setZone(z)
            end
        end,
    })
    regDropdown("petalZone", dZone, function() return zoneName end, function(v)
        setZone(v)
    end)

    local autoNoclip = false  -- 穿透是不是由「自動撿花」幫你打開的
    local autoNoclipOn = true  -- 撿花時要不要自動開穿透
    local tPetal = AfkTab:CreateToggle({
        Name = "自動撿花（走過去）",
        CurrentValue = false,
        Callback = function(v)
            petalOn = v
            Move.setUser("petal", v)
            if v then
                buildWalls()
                Move.check()
            else
                clearWalls()
                Move.stop(getHumanoid(), getRoot())
            end
            -- 啟動時自動開穿透，讓角色能直接穿過物件走過去；關閉時只還原自己開的那次
            if v and autoNoclipOn and Move.mode ~= "fly" and not noclipOn then
                autoNoclip = true
                pcall(function() tNoclip:Set(true) end)
            elseif not v and autoNoclip then
                autoNoclip = false
                pcall(function() tNoclip:Set(false) end)
            end
        end,
    })
    -- 不存檔：避免下次載入設定時一開腳本就自己開始撿花、亂跑

    local tAutoNoclip = AfkTab:CreateToggle({
        Name = "撿花時自動穿透",
        CurrentValue = true,
        Callback = function(v)
            autoNoclipOn = v
        end,
    })
    regToggle("autoNoclip", tAutoNoclip, function() return autoNoclipOn end)

    UI:OnClose(function()
        petalOn = false
        Move.release()
        clearWalls()
        if autoNoclip then
            autoNoclip = false
            noclipOn = false
            restoreNoclip()
        end
    end)

    local iPetalRange = AfkTab:CreateInput({
        Name = "撿花範圍（輸入數字）",
        PlaceholderText = "預設 120，只追這個距離內的花",
        Callback = function(text)
            local n = tonumber(text)
            if n and n > 0 then
                petalRange = n
                notify("已設定", "撿花範圍 = " .. n)
            else
                notify("輸入錯誤", "請輸入大於 0 的數字")
            end
        end,
    })
    regNumber("petalRange", iPetalRange, function() return petalRange end, function(v)
        petalRange = v
    end)

    local tGoHome = AfkTab:CreateToggle({
        Name = "撿完花走回掛機點",
        CurrentValue = true,
        Callback = function(v)
            goHomeOn = v
        end,
    })
    regToggle("petalGoHome", tGoHome, function() return goHomeOn end)

    local function homeText()
        return string.format("%.1f, %.1f, %.1f", homePos.X, homePos.Y, homePos.Z)
    end

    local function parseHome(text)
        local x, y, z = tostring(text):match("(-?%d+%.?%d*)%s*[,%s]%s*(-?%d+%.?%d*)%s*[,%s]%s*(-?%d+%.?%d*)")
        x, y, z = tonumber(x), tonumber(y), tonumber(z)
        if x and y and z then
            return Vector3.new(x, y, z)
        end
    end

    local iHome = AfkTab:CreateInput({
        Name = "掛機點座標（x, y, z）",
        PlaceholderText = "預設 652, 4, -598",
        Callback = function(text)
            local v = parseHome(text)
            if v then
                homePos = v
                notify("已設定掛機點", "(" .. homeText() .. ")")
            else
                notify("輸入錯誤", "請輸入三個數字，例如 652, 4, -598")
            end
        end,
    })
    onHomeChanged = function()
        pcall(function() iHome:Set(homeText()) end)
    end
    FarmAPI.setHome = function(v)
        homePos = v
        onHomeChanged()
    end

    regText("petalHome", iHome, homeText, function(v)
        local pv = parseHome(v)
        if pv then
            homePos = pv
        end
    end)

    AfkTab:CreateButton({
        Name = "把目前位置設為掛機點",
        Callback = function()
            local root = getRoot()
            if root then
                homePos = root.Position
                notify("已設定掛機點", "(" .. homeText() .. ")")
                pcall(function() iHome:Set(homeText()) end)
            else
                notify("設定失敗", "找不到角色")
            end
        end,
    })
end

-- ========== 翻機器人 ==========
AfkTab:CreateSection("翻機器人")

do
    local flipOn = false
    local flipDelay = 7.2         -- 遊戲每 7 秒才能點一次，多留 0.2 秒保險
    local lastClickAt = 0
    local jackpotFlowers = 3000   -- 中大獎會增加的花朵數（判斷用）
    local targetInfo = "--"        -- 目前的目標（顯示用）
    local extraDelay = 0           -- 遊戲自己有冷卻：沒收到回應就自動多等一點
    local failCount = setmetatable({}, {__mode = "k"})
    local lastResult, lastResultTime = nil, 0
    local skipUntil = setmetatable({}, {__mode = "k"})
    local tFlip

    local function ser(v, d)
        d = d or 0
        if type(v) == "table" and d < 3 then
            local t = {}
            for k, x in pairs(v) do
                table.insert(t, tostring(k) .. "=" .. ser(x, d + 1))
            end
            return "{" .. table.concat(t, ", ") .. "}"
        end
        return tostring(v)
    end

    -- 聽伺服器傳回來的點擊結果（沒中獎時會收到 type = "miss"）
    task.spawn(function()
        local ev = game:GetService("ReplicatedStorage"):WaitForChild("RobotGameEvent", 10)
        if ev and ev:IsA("RemoteEvent") then
            ev.OnClientEvent:Connect(function(...)
                lastResult = {...}
                lastResultTime = tick()
            end)
        else
            warn("[卡依腳本] 找不到 RobotGameEvent，自動翻機器人無法判斷結果")
        end
    end)

    -- 讀畫面上的花朵數（例如「🌸 5897 / 5000」或「🌸 5,897」）
    local function dig(root, ...)
        local cur = root
        for _, name in ipairs({...}) do
            cur = cur and cur:FindFirstChild(name)
        end
        return cur
    end

    local function readFlowers()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then
            return nil
        end
        local lbl = dig(pg, "HintPurchaseUI", "FlowerCard", "FlowerText")
            or dig(pg, "PinballGui", "Main", "Frame", "TextLabel")
        local num = lbl and tostring(lbl.Text):match("([%d,]+)")
        return num and tonumber((num:gsub(",", "")))
    end

    local function finish(title, msg)
        flipOn = false
        Move.stop(getHumanoid(), getRoot())
        pcall(function() tFlip:Set(false) end)
        notify(title, msg, 10)
    end

    local function nearestRobot(root)
        local hunt = workspace:FindFirstChild("RobotTreasureHunt")
        local folder = hunt and hunt:FindFirstChild("Robots")
        if not folder then
            return nil
        end
        local best, bestD, bestCd
        for _, r in ipairs(folder:GetChildren()) do
            if r:IsA("BasePart") and (skipUntil[r] or 0) < tick()
                and r.Transparency < 0.95 then  -- 被翻掉消失的（變透明）不點
                local cd = r:FindFirstChildOfClass("ClickDetector")
                if cd and not (FarmAPI.inHazard and FarmAPI.inHazard(r.Position)) then
                    local d = (r.Position - root.Position).Magnitude
                    if not bestD or d < bestD then
                        best, bestD, bestCd = r, d, cd
                    end
                end
            end
        end
        return best, bestCd
    end

    -- 走到機器人旁邊（進入點擊距離內）
    local function approach(hum, root, robot, cd)
        local need = math.max(math.min(cd.MaxActivationDistance, 10) - 2, 4)
        local t0 = tick()
        local lastPos, lastCheck = root.Position, tick()
        while flipOn and robot.Parent and robot.Transparency < 0.95
            and hum.Health > 0 and tick() - t0 < 8 do
            if (robot.Position - root.Position).Magnitude <= need then
                return true
            end
            local wp = FarmAPI.detour and FarmAPI.detour(root.Position, robot.Position)
            Move.to(hum, root, wp or robot.Position)
            if tick() - lastCheck > 0.7 then
                if (root.Position - lastPos).Magnitude < 1 then
                    hum.Jump = true
                end
                lastPos, lastCheck = root.Position, tick()
            end
            task.wait(0.1)
        end
        return false
    end

    local function step()
        local root, hum = getRoot(), getHumanoid()
        if not (root and hum) or hum.Health <= 0 then
            return
        end
        local robot, cd = nearestRobot(root)
        if not robot then
            targetInfo = "附近沒有可以點的機器人"
            return
        end
        targetInfo = string.format("%s 透明=%.2f 距離=%d", robot.Name, robot.Transparency,
            (robot.Position - root.Position).Magnitude)
        targetInfo = targetInfo .. string.format(" 等待+%.1fs", extraDelay)

        -- 一定要走到機器人旁邊才點（不能遠距點擊）
        local arrived = approach(hum, root, robot, cd)
        Move.stop(hum, root)
        if not arrived then
            skipUntil[robot] = tick() + 5
            return
        end
        -- 冷卻還沒到就先站在旁邊等（走路的時間也算在冷卻裡，所以不會浪費）
        while flipOn and robot.Parent and robot.Transparency < 0.95
            and tick() - lastClickAt < flipDelay + extraDelay do
            local left = flipDelay + extraDelay - (tick() - lastClickAt)
            targetInfo = string.format("%s 冷卻中，還要等 %.1f 秒", robot.Name, math.max(left, 0))
            task.wait(0.1)
        end
        if not (flipOn and robot.Parent) then
            return
        end
        -- 走到之後、點之前，再確認一次它還在（可能剛好被別人翻掉了）
        if robot.Transparency >= 0.95 then
            skipUntil[robot] = tick() + 300
            return
        end

        local before = lastResultTime
        local flowersBefore = readFlowers()
        local function gained()
            local f = readFlowers()
            return (f and flowersBefore) and (f - flowersBefore) or nil
        end
        lastClickAt = tick()
        pcall(fireclickdetector, cd)

        -- 等伺服器回報結果
        local t0 = tick()
        while flipOn and tick() - t0 < 2.5 and lastResultTime <= before do
            task.wait(0.05)
        end

        if lastResultTime > before then
            -- 伺服器有回應，代表這隻已經翻過了，5 分鐘內不再點（它可能只是變透明、還留在場上）
            skipUntil[robot] = tick() + 300
            local d = lastResult and lastResult[1]
            local kind = type(d) == "table" and d.type or d
            if kind ~= "miss" then
                -- 不是「沒中」：再等最多 2 秒看花朵有沒有增加，用來確認是不是真的中大獎
                local t1, g = tick(), gained()
                while flipOn and tick() - t1 < 2 and not (g and g >= jackpotFlowers) do
                    task.wait(0.1)
                    g = gained()
                end
                if g and g >= jackpotFlowers then
                    finish("中大獎了！", "花朵 +" .. g)
                else
                    finish("收到不是 miss 的結果",
                        "花朵沒有增加 " .. jackpotFlowers .. "，請自己確認：" .. ser(lastResult))
                end
            else
                -- 就算事件寫 miss，只要花朵一次暴增也算中獎
                local g = gained()
                if g and g >= jackpotFlowers then
                    finish("中大獎了！", "花朵 +" .. g)
                end
            end
        else
            -- 沒收到回應：很可能還在遊戲自己的冷卻裡，不能硬點。
            -- 自動多等 0.5 秒（最多 6 秒），同一隻最多重試 3 次才換下一隻
            extraDelay = math.min(extraDelay + 0.5, 6)
            failCount[robot] = (failCount[robot] or 0) + 1
            if failCount[robot] >= 3 then
                failCount[robot] = nil
                skipUntil[robot] = tick() + 5
            end
        end
    end

    task.spawn(function()
        while true do
            if flipOn then
                local ok, err = pcall(step)
                if not ok then
                    warn("[卡依腳本] 自動翻機器人錯誤：" .. tostring(err))
                    task.wait(1)
                end
                task.wait(0.1)
            else
                task.wait(0.3)
            end
        end
    end)

    -- 顯示目前正要點的機器人（除錯用，點一下可以複製）
    do
        local n = #langItems
        local targetBtn = AfkTab:CreateButton({
            Name = "目前目標  --",
            Callback = function()
                if setclipboard then
                    pcall(setclipboard, targetInfo)
                end
                notify("目前目標", targetInfo, 4)
            end,
        })
        while #langItems > n do
            table.remove(langItems)
        end
        task.spawn(function()
            while true do
                targetBtn:SetName((useEnglish and "Target  " or "目前目標  ") .. targetInfo)
                task.wait(0.3)
            end
        end)
    end

    tFlip = AfkTab:CreateToggle({
        Name = "自動翻機器人（到有結果為止）",
        CurrentValue = false,
        Callback = function(v)
            if v and not fireclickdetector then
                notify("無法啟用", "這個執行器不支援 fireclickdetector")
                task.defer(function()
                    pcall(function() tFlip:Set(false) end)
                end)
                return
            end
            flipOn = v
            Move.setUser("flip", v)
            if v then
                Move.check()
            else
                Move.stop(getHumanoid(), getRoot())
            end
        end,
    })
    -- 不存檔：避免下次載入設定時一啟動就自動點

    local iFlipDelay = AfkTab:CreateInput({
        Name = "翻機器人間隔（秒）",
        PlaceholderText = "預設 7.2（遊戲冷卻 7 秒）",
        Callback = function(text)
            local n = tonumber(text)
            if n and n >= 0 then
                flipDelay = n
                notify("已設定", "間隔 = " .. n .. " 秒")
            else
                notify("輸入錯誤", "請輸入數字")
            end
        end,
    })
    regNumber("flipDelay", iFlipDelay, function() return flipDelay end, function(v)
        flipDelay = v
    end)

    local iJackpot = AfkTab:CreateInput({
        Name = "大獎花朵數（判斷用）",
        PlaceholderText = "預設 3000，中大獎會增加的花朵",
        Callback = function(text)
            local n = tonumber(text)
            if n and n > 0 then
                jackpotFlowers = n
                notify("已設定", "大獎花朵數 = " .. n)
            else
                notify("輸入錯誤", "請輸入大於 0 的數字")
            end
        end,
    })
    regNumber("jackpotFlowers", iJackpot, function() return jackpotFlowers end, function(v)
        jackpotFlowers = v
    end)

    UI:OnClose(function()
        flipOn = false
    end)
end

