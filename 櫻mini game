-- ===== 穿透（Noclip）：自動撿花啟動時會自動打開 =====
local noclipOn = false
local noclipParts = {}

local function restoreNoclip()
    for p in pairs(noclipParts) do
        if p.Parent then
            p.CanCollide = true
        end
    end
    noclipParts = {}
end

RunService.Stepped:Connect(function()
    if not noclipOn then
        return
    end
    local char = LocalPlayer.Character
    if not char then
        return
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            noclipParts[p] = true
            p.CanCollide = false
        end
    end
end)

-- 讓下面的程式可以用 tNoclip:Set(true/false)
local tNoclip = {}
function tNoclip:Set(v)
    noclipOn = v and true or false
    if not noclipOn then
        restoreNoclip()
    end
end

-- ===== 搖桿移動 =====
-- 遊戲的移動是伺服器在控制，叫角色直接走（MoveTo）會被拉回原地，
-- 所以改成「操作螢幕上的搖桿」：
--   搖桿（模擬觸控）：在螢幕搖桿上模擬手指按住、推動
--   搖桿（控制模組）：直接對遊戲的控制模組輸出搖桿的移動方向（模擬觸控沒反應時用）
--   飄（飛行）：像主腳本的「飛行」一樣飄在地面上方移動（不會踩到傳送陣）
--   直接走（舊方式）：原本的 MoveTo
local GuiService = game:GetService("GuiService")
local VIM = game:GetService("VirtualInputManager")

local MODE_NAMES = {"搖桿（模擬觸控）", "搖桿（控制模組）", "飄（飛行）", "直接走（舊方式）"}
local MODE_LABELS = {
    ["搖桿（模擬觸控）"] = "touch",
    ["搖桿（控制模組）"] = "module",
    ["飄（飛行）"] = "fly",
    ["直接走（舊方式）"] = "moveto",
}

local Move = {
    mode = "touch",
    modeName = MODE_NAMES[1],
    dir = nil,               -- 想走的方向（水平的單位向量），nil = 不動
    vec = Vector3.zero,      -- 搖桿的輸出（相機座標）
    touching = false,
    lx = 0, ly = 0,
    area = nil, pad = 2,     -- 撿花時用來把角色限制在區域內
    dist = 0,                -- 離目標的水平距離
    flySpeed = 30,           -- 飄行速度
    safeSpeed = true,        -- 飄行速度不超過安全上限（防走路速度偵測）
    safeCap = 15,            -- 安全上限（格/秒）；這個遊戲走路 16.7 沒事，50 會被踢
    hover = 4,               -- 飄行時離地高度
    bv = nil,                -- 飄行用的 BodyVelocity
    users = {},              -- 哪些功能正在用移動（撿花、翻機器人）
    active = false,
}
local TOUCH_ID = 11
local hasTouchApi = pcall(function()
    local _ = VIM.SendTouchEvent
end)

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- 找螢幕上的搖桿（固定搖桿或動態搖桿）
local function findStick()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local tg = pg and pg:FindFirstChild("TouchGui")
    local tf = tg and tg:FindFirstChild("TouchControlFrame")
    if not tf then
        return nil
    end
    for _, name in ipairs({"ThumbstickFrame", "DynamicThumbstickFrame"}) do
        local f = tf:FindFirstChild(name)
        if f and f.Visible then
            return f, name, tg
        end
    end
    return nil
end

-- 搖桿的中心點（螢幕座標）和推到底的半徑
local function stickGeometry()
    local f, name, tg = findStick()
    if not f then
        return nil
    end
    local inset = Vector2.new(0, 0)
    if tg and not tg.IgnoreGuiInset then
        inset = GuiService:GetGuiInset()
    end
    local pos, size = f.AbsolutePosition + inset, f.AbsoluteSize
    if name == "ThumbstickFrame" then
        return pos + size / 2, math.min(size.X, size.Y) / 2 * 0.8
    end
    -- 動態搖桿：在這個區域內按下去的位置就是搖桿中心
    return pos + Vector2.new(size.X * 0.5, size.Y * 0.6), 55
end

local function sendTouch(state, x, y)
    return pcall(function()
        VIM:SendTouchEvent(TOUCH_ID, state, x, y)
    end)
end

-- 實際用的方式：模擬觸控找不到搖桿或不支援時，自動改用控制模組
function Move.effective()
    if Move.mode == "moveto" then
        return "moveto"
    end
    if Move.mode == "fly" then
        return "fly"
    end
    if Move.mode == "touch" and hasTouchApi and stickGeometry() then
        return "touch"
    end
    return "module"
end

-- 控制模組：把遊戲讀搖桿的函式換成我們的輸出（沒在移動時還是用真的搖桿）
local hooked = nil
local lastHookTry = 0
local function ensureHook()
    if tick() - lastHookTry < 0.5 then
        return
    end
    lastHookTry = tick()
    local ok, ctrl = pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        local pm = ps and ps:FindFirstChild("PlayerModule")
        return pm and require(pm):GetControls()
    end)
    if not (ok and ctrl) then
        return
    end
    local ac = ctrl.activeController
    if ac and hooked ~= ac then
        hooked = ac
        local og = ac.GetMoveVector
        ac.GetMoveVector = function(self2, ...)
            if Move.dir and Move.effective() == "module" then
                return Move.vec
            end
            return og(self2, ...)
        end
    end
end

-- 朝 pos 的方向走（clamp = true 時不讓角色走出掛機區）
function Move.to(hum, root, pos, clamp)
    if Move.effective() == "moveto" then
        hum:MoveTo(pos)
        return
    end
    local off = flat(pos - root.Position)
    Move.dist = off.Magnitude
    if off.Magnitude < 1 then
        Move.dir = nil
        return
    end
    local d = off.Unit
    if clamp and Move.area then
        local a, pad, p = Move.area, Move.pad, root.Position
        local x, z = d.X, d.Z
        if p.X <= a.minX + pad and x < 0 then x = 0 end
        if p.X >= a.maxX - pad and x > 0 then x = 0 end
        if p.Z <= a.minZ + pad and z < 0 then z = 0 end
        if p.Z >= a.maxZ - pad and z > 0 then z = 0 end
        local v = Vector3.new(x, 0, z)
        if v.Magnitude < 0.2 then
            Move.dir = nil
            return
        end
        d = v.Unit
    end
    Move.dir = d
end

function Move.stop(hum, root)
    Move.dir = nil
    if Move.mode == "moveto" and hum and root then
        hum:MoveTo(root.Position)
    end
end

-- 放開搖桿（關閉腳本時用）
function Move.release()
    Move.dir = nil
    Move.users.petal, Move.users.flip = false, false
    Move.active = false
    Move.dropFly()
    if Move.touching then
        sendTouch(2, Move.lx, Move.ly)
        Move.touching = false
    end
end

-- 開始用搖桿前的檢查：找不到搖桿、或選單擋住搖桿時提醒
function Move.check()
    if Move.mode == "touch" and Move.effective() ~= "touch" then
        notify("找不到螢幕搖桿", "已改用控制模組模擬搖桿；沒反應的話，到「移動方式」換一種", 6)
    elseif Move.effective() == "touch" then
        local c = stickGeometry()
        if c and UI:IsOverMenu(c.X, c.Y) then
            notify("選單擋住搖桿", "請先隱藏選單，不然搖桿會按不到", 6)
        end
    end
end

-- 哪個功能正在使用移動（都沒在用時，飄行會關掉）
function Move.setUser(name, v)
    Move.users[name] = v and true or false
    Move.active = (Move.users.petal or Move.users.flip) and true or false
end

-- 飄行：用 BodyVelocity 讓角色飄在地面上方，水平方向朝目標移動
local flyParams = RaycastParams.new()
flyParams.FilterType = Enum.RaycastFilterType.Exclude

function Move.dropFly()
    Move.gyF = nil
    if Move.bv then
        Move.bv:Destroy()
        Move.bv = nil
    end
end

local function groundYAt(pos)
    local ignore = {}
    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end
    local petals = workspace:FindFirstChild("FlowerPetals")
    if petals then
        table.insert(ignore, petals)
    end
    flyParams.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -300, 0), flyParams)
    return hit and hit.Position.Y or nil
end

function Move.flyStep(d)
    local root = getRoot()
    if not (root and Move.active) then
        Move.dropFly()
        return
    end
    if not Move.bv or Move.bv.Parent ~= root then
        Move.dropFly()
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root
        Move.bv = bv
    end
    -- 垂直：維持在地面上方 hover 格；水平：朝目標移動，越靠近越慢
    local gy = groundYAt(root.Position)
    -- 防走路速度偵測：水平、垂直速度都不超過走路速度（略低一點）
    local cap = nil
    if Move.safeSpeed then
        local hum = getHumanoid()
        cap = math.min(math.max((hum and hum.WalkSpeed or 16) * 0.9, 4), Move.safeCap)
    end
    local vy = 0
    if gy then
        -- 地面高度做平滑，避免偵測到的地面忽高忽低，讓角色上下抖
        Move.gyF = Move.gyF and (Move.gyF + (gy - Move.gyF) * 0.15) or gy
        local err = (Move.gyF + Move.hover) - root.Position.Y
        -- 差不到 0.5 格就不修正（死區），不然停下來時會一直上下晃
        if math.abs(err) > 0.5 then
            vy = math.clamp(err * 3, -(cap or 25), cap or 25)
        end
    end
    local hv = Vector3.zero
    if d then
        hv = d * math.min(Move.flySpeed, cap or math.huge, math.max(Move.dist, 1) * 6)
    end
    Move.bv.Velocity = Vector3.new(hv.X, vy, hv.Z)
end

RunService.Heartbeat:Connect(function()
    local d = Move.dir
    local mode = Move.effective()

    -- 不用觸控了（停止、或換了方式）就放開手指
    if Move.touching and not (d and mode == "touch") then
        sendTouch(2, Move.lx, Move.ly)
        Move.touching = false
    end
    if mode == "fly" then
        Move.flyStep(d)
        return
    else
        Move.dropFly()
    end
    if not d or mode == "moveto" then
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then
        return
    end
    -- 搖桿往上 = 相機的前方，所以要把世界方向換成「相機的前、右」
    local look, right = flat(cam.CFrame.LookVector), flat(cam.CFrame.RightVector)
    if look.Magnitude > 0.01 then look = look.Unit end
    if right.Magnitude > 0.01 then right = right.Unit end
    local sx, sy = d:Dot(right), d:Dot(look)
    Move.vec = Vector3.new(sx, 0, -sy)

    if mode == "touch" then
        local center, radius = stickGeometry()
        if center then
            if not Move.touching then
                sendTouch(0, center.X, center.Y)
                Move.touching = true
            end
            local p = center + Vector2.new(sx, -sy) * radius
            Move.lx, Move.ly = p.X, p.Y
            sendTouch(1, p.X, p.Y)
        end
    else
        ensureHook()
    end
end)

-- ===== 設定存檔（只存這個介面自己的設定）=====
local CONFIG_FILE = "KaiScript_SakuraAFK.json"
local reg = {}

local function regToggle(key, el, get)
    table.insert(reg, {key = key, kind = "toggle", el = el, get = get})
end
local function regNumber(key, el, get, set)
    table.insert(reg, {key = key, kind = "number", el = el, get = get, set = set})
end
local function regDropdown(key, el, get, set)
    table.insert(reg, {key = key, kind = "dropdown", el = el, get = get, set = set})
end
local function regText(key, el, get, set)
    table.insert(reg, {key = key, kind = "text", el = el, get = get, set = set})
end

local function saveConfig()
    if not (writefile and HttpService) then
        notify("無法儲存", "這個執行器不支援檔案功能")
        return
    end
    local data = {}
    for _, r in ipairs(reg) do
        data[r.key] = r.get()
    end
    local ok, err = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    if ok then
        notify("已儲存", "櫻 mini game AFK 的設定已存檔")
    else
        notify("儲存失敗", tostring(err))
    end
end

local function loadConfig(quiet)
    if not (isfile and readfile) or not isfile(CONFIG_FILE) then
        if not quiet then
            notify("沒有存檔", "請先按「儲存設定」")
        end
        return
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(data) ~= "table" then
        return
    end
    -- 先套用數字、選項和文字（地塊要先於掛機點），再套用開關
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil then
            if r.kind == "number" and type(v) == "number" then
                pcall(function() r.set(v) r.el:Set(tostring(v)) end)
            elseif r.kind == "dropdown" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set({v}) end)
            elseif r.kind == "text" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set(v) end)
            end
        end
    end
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil and r.kind == "toggle" and type(v) == "boolean" then
            pcall(function() r.el:Set(v) end)
        end
    end
    if not quiet then
        notify("已載入", "設定已套用")
    end
end

