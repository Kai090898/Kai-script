-- ===== 序列化（顯示用）=====
local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then
        local s = (v:gsub("\n", "\\n"))
        if #s > 60 then s = s:sub(1, 60) .. "…" end
        return '"' .. s .. '"'
    elseif t == "number" then
        if v == math.floor(v) then return tostring(v) end
        return string.format("%.3f", v)
    elseif t == "table" then
        if d >= 3 then return "{…}" end
        local parts, c = {}, 0
        for k, x in pairs(v) do
            c = c + 1
            if c > 12 then
                table.insert(parts, "…")
                break
            end
            table.insert(parts, tostring(k) .. "=" .. ser(x, d + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    elseif t == "Instance" then
        return "<" .. pathOf(v) .. ">"
    end
    return tostring(v)
end
local function serArgs(args)
    local parts = {}
    for i = 1, args.n do
        parts[i] = ser(args[i])
    end
    return table.concat(parts, ", ")
end

-- ===== 轉成可以直接執行的 Lua（重播指令用）=====
local function q(s)
    s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r")
    return '"' .. s .. '"'
end
local function instLua(inst)
    local chain = {}
    local cur = inst
    while cur and cur ~= game do
        table.insert(chain, 1, cur)
        cur = cur.Parent
    end
    if cur ~= game or #chain == 0 then
        return "nil --[[" .. inst.Name .. "]]"
    end
    local out = 'game:GetService("' .. chain[1].Name .. '")'
    for i = 2, #chain do
        out = out .. ":WaitForChild(" .. q(chain[i].Name) .. ")"
    end
    return out
end
local function toLua(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then
        return q(v)
    elseif t == "number" then
        if v ~= v then return "0/0" end
        if v == math.huge then return "math.huge" end
        if v == -math.huge then return "-math.huge" end
        return tostring(v)
    elseif t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Instance" then
        return instLua(v)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return string.format("Vector2.new(%s, %s)", v.X, v.Y)
    elseif t == "CFrame" then
        return "CFrame.new(" .. table.concat({v:GetComponents()}, ", ") .. ")"
    elseif t == "Color3" then
        return string.format("Color3.new(%s, %s, %s)", v.R, v.G, v.B)
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        if d >= 6 then return "{}" end
        local parts, used = {}, {}
        for i = 1, #v do
            parts[#parts + 1] = toLua(v[i], d + 1)
            used[i] = true
        end
        for k, x in pairs(v) do
            if not used[k] then
                local ks
                if type(k) == "string" and k:match("^[%a_][%w_]*$") then
                    ks = k
                else
                    ks = "[" .. toLua(k, d + 1) .. "]"
                end
                parts[#parts + 1] = ks .. " = " .. toLua(x, d + 1)
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return "nil --[[" .. t .. "]]"
end
local function replayLine(e)
    local parts = {}
    for i = 1, e.args.n do
        parts[i] = toLua(e.args[i])
    end
    return instLua(e.remote) .. ":" .. e.method .. "(" .. table.concat(parts, ", ") .. ")"
end

-- ===== 紀錄核心 =====
local S = {}                 -- 各感應器的開關
local C = {                  -- 設定
    filter = "",
    autoMute = true,
    muteLimit = 8,
    scanRadius = 30,
    watchPath = "",
    watchGui = "",
}
local paused = false
local LOG_MAX = 4000
local logs, counts = {}, {}
local feedFull = {}          -- 最新在前，最多 FEED_N 筆
local FEED_N = 10
local rate, muted = {}, {}
local totalEvents = 0
local filterList = {}
local recent = {}            -- 最近送出的 Remote（重播用）

local function setFilter(text)
    C.filter = tostring(text or "")
    filterList = {}
    for piece in C.filter:lower():gmatch("[^|]+") do
        piece = piece:gsub("^%s+", ""):gsub("%s+$", "")
        if piece ~= "" then table.insert(filterList, piece) end
    end
end
local function passFilter(tag, text)
    if #filterList == 0 then return true end
    local hay = (tag .. " " .. text):lower()
    for _, f in ipairs(filterList) do
        if hay:find(f, 1, true) then return true end
    end
    return false
end

local function push(tag, text)
    local line = string.format("[%.1f] %s：%s", tick() - t0, tag, text)
    table.insert(logs, line)
    if #logs > LOG_MAX + 500 then
        table.move(logs, 501, #logs, 1)
        for i = #logs, #logs - 499, -1 do
            logs[i] = nil
        end
    end
    table.insert(feedFull, 1, line)
    if #feedFull > FEED_N then table.remove(feedFull) end
    totalEvents = totalEvents + 1
end

-- tag = 分類，text = 顯示內容，key = 統計 / 靜音用的名字，w = 這筆代表幾次
local function emit(tag, text, key, w)
    if paused or not alive then return end
    key = key or text
    local full = tag .. "｜" .. key
    counts[full] = (counts[full] or 0) + (w or 1)
    if muted[full] then return end
    if not passFilter(tag, text) then return end
    if C.autoMute then
        local now = tick()
        local r = rate[full]
        if not r or now - r.t >= 1 then
            r = {n = 0, t = now}
            rate[full] = r
        end
        r.n = r.n + 1
        if r.n > C.muteLimit then
            muted[full] = true
            push("系統", "已自動靜音（太頻繁）：" .. cut(full, 60))
            return
        end
    end
    push(tag, text)
end

-- ===== 連線管理 =====
local conns = {}
local function hold(name, c)
    conns[name] = conns[name] or {}
    table.insert(conns[name], c)
end
local function release(name)
    for _, c in ipairs(conns[name] or {}) do
        pcall(function() c:Disconnect() end)
    end
    conns[name] = nil
end

