GuiTab:CreateSection("點擊感應（點哪裡就告訴你點到什麼）")
do
    local function describeGui(o)
        local s = pathOf(o) .. " [" .. o.ClassName .. "]"
        if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
            if o.Text ~= "" then
                s = s .. " 文字=" .. cut((o.Text:gsub("\n", " ")), 40)
            end
        elseif o:IsA("ImageButton") or o:IsA("ImageLabel") then
            s = s .. " 圖片=" .. cut(tostring(o.Image), 40)
        end
        local attrs = o:GetAttributes()
        for k, v in pairs(attrs) do
            s = s .. " 屬性" .. k .. "=" .. ser(v)
        end
        return s
    end

    local function describePart(p)
        local s = pathOf(p) .. " [" .. p.ClassName .. "]"
        for k, v in pairs(p:GetAttributes()) do
            s = s .. " 屬性" .. k .. "=" .. ser(v)
        end
        local n = 0
        for _, c in ipairs(p:GetDescendants()) do
            if c:IsA("ProximityPrompt") then
                s = s .. " ｜提示框「" .. c.ActionText .. "」"
            elseif c:IsA("ClickDetector") then
                s = s .. " ｜點擊偵測"
            elseif c.ClassName == "TouchTransmitter" then
                s = s .. " ｜碰觸感應"
            elseif c:IsA("ValueBase") then
                s = s .. " ｜" .. c.Name .. "=" .. ser(c.Value)
            end
            n = n + 1
            if n > 40 then break end
        end
        return s
    end

    local function probeAt(x, y)
        local pg = getPg()
        local list, seen = {}, {}
        if pg then
            local inset = GuiService:GetGuiInset()
            for _, yy in ipairs({y, y + inset.Y, y - inset.Y}) do
                local ok, objs = pcall(function() return pg:GetGuiObjectsAtPosition(x, yy) end)
                if ok and #objs > 0 then
                    for _, o in ipairs(objs) do
                        if not seen[o] then
                            seen[o] = true
                            table.insert(list, o)
                        end
                    end
                    break
                end
            end
        end
        local shownGui = 0
        for _, o in ipairs(list) do
            local p = pathOf(o)
            if not isOwn(p) then
                shownGui = shownGui + 1
                emit(shownGui == 1 and "點擊介面" or "點擊介面（下層）", describeGui(o), p)
                if shownGui >= 5 then break end
            end
        end
        local cam = workspace.CurrentCamera
        if cam then
            local ray = cam:ScreenPointToRay(x, y)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {LocalPlayer.Character}
            local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
            if res and res.Instance then
                emit("點擊物件", describePart(res.Instance), pathOf(res.Instance))
            end
        end
    end

    sensorToggle(GuiTab, "感應 點擊（介面與 3D 物件）", "click", function()
        hold("click", UIS.InputBegan:Connect(function(input)
            local ut = input.UserInputType
            if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
                local pos = input.Position
                task.defer(function()
                    local ok, err = pcall(probeAt, pos.X, pos.Y)
                    if not ok then push("系統", "點擊感應出錯：" .. tostring(err)) end
                end)
            end
        end))
    end)
end

