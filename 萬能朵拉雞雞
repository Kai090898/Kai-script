ObjTab:CreateSection("新增 / 移除（同一種物件一秒內自動合併成「×數量」）")
local batchAdd, batchRem = {}, {}
local function objKey(d)
    local p = pathOf(d)
    if isOwn(p) then return nil end
    return (p:gsub("%d+", "#")) .. " [" .. d.ClassName .. "]"
end
local function bump(b, d)
    local k = objKey(d)
    if k then b[k] = (b[k] or 0) + 1 end
end
local function flush(tag, b)
    if next(b) == nil then return end
    local rows = {}
    for k, n in pairs(b) do
        rows[#rows + 1] = {k = k, n = n}
    end
    for k in pairs(b) do
        b[k] = nil
    end
    table.sort(rows, function(a, c) return a.n > c.n end)
    for i = 1, math.min(#rows, 8) do
        emit(tag, string.format("×%d %s", rows[i].n, rows[i].k), rows[i].k, rows[i].n)
    end
    if #rows > 8 then
        emit(tag, "…另外還有 " .. (#rows - 8) .. " 種", tag .. "其他")
    end
end
task.spawn(function()
    while alive do
        task.wait(1)
        pcall(flush, "新增", batchAdd)
        pcall(flush, "移除", batchRem)
    end
end)

