    end)

    -- 路徑解析：支援 game.X.Y、Workspace.X、ReplicatedStorage.X、LocalPlayer.X，以及紀錄裡的「我.X」
    local function resolvePath(text)
        local cur = game
        local parts = {}
        for p in tostring(text or ""):gmatch("[^%.]+") do
            p = p:gsub("^%s+", ""):gsub("%s+$", "")
            if p ~= "" then table.insert(parts, p) end
        end
        if #parts == 0 then return nil, "路徑是空的" end
        local i = 1
        if parts[1] == "game" then
            i = 2
        elseif parts[1] == "我" or parts[1] == "LocalPlayer" then
            cur = LocalPlayer
            i = 2
        end
        for j = i, #parts do
            local nxt
            if cur == game then
                pcall(function() nxt = game:GetService(parts[j]) end)
            end
            nxt = nxt or cur:FindFirstChild(parts[j])
            if not nxt then return nil, "找不到 " .. parts[j] end
            cur = nxt
        end
        return cur
    end

    textInput(CharTab, "指定物件路徑", "例如 Workspace.Camera.EggOpenMap（可直接貼紀錄裡的路徑）", function(text)
        C.watchPath = text
        notify("已設定", "監看路徑 = " .. text)
    end)
    sensorToggle(CharTab, "感應 指定物件（屬性、屬性值、子孫新增移除）", "watch", function()
        local inst, err = resolvePath(C.watchPath)
        if not inst then error(err or "路徑錯誤") end
        local p = pathOf(inst)
        if inst:IsA("ValueBase") then
            hold("watch", inst.Changed:Connect(function(val)
