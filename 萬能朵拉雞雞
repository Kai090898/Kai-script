-- 送出：攔截 FireServer / InvokeServer。
-- 注意：攔截函式裡不能呼叫任何 Instance 的方法（會蓋掉 namecall 狀態），
-- 所以只複製參數，真正的記錄丟到下一個時間點再做。
local hookDone = false
local function installHook()
    if hookDone then return true end
    if not (hookmetamethod and getnamecallmethod and newcclosure) then
        return false
    end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if S.spyOut then
                local m = getnamecallmethod()
                if (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
                    local args = {n = select("#", ...), ...}
                    local target = self
                    task.defer(function()
                        pcall(function()
                            if typeof(target) ~= "Instance" or not string.find(target.ClassName, "Remote") then
                                return
                            end
                            local p = pathOf(target)
                            table.insert(recent, {remote = target, method = m, args = args})
                            if #recent > 40 then table.remove(recent, 1) end
                            emit("送出", p .. (m == "InvokeServer" and "（Invoke）" or "") .. "｜" .. serArgs(args), p)
                        end)
                    end)
                end
            end
            return old(self, ...)
        end))
    end)
    hookDone = ok
    return ok
end

sensorToggle(RemoteTab, "感應 我送出的 Remote", "spyOut", function()
    if not installHook() then
