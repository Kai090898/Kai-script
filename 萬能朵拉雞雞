-- 收到：連上所有 RemoteEvent 的 OnClientEvent
sensorToggle(RemoteTab, "感應 伺服器傳來的 Remote", "spyIn", function()
    local function hookRemote(r)
        if r:IsA("RemoteEvent") or r.ClassName == "UnreliableRemoteEvent" then
            local p = pathOf(r)
            hold("spyIn", r.OnClientEvent:Connect(function(...)
                local args = {n = select("#", ...), ...}
                emit("收到", p .. "｜" .. serArgs(args), p)
            end))
        end
    end
    local roots = {RS, workspace, LocalPlayer, game:GetService("ReplicatedFirst")}
    for _, root in ipairs(roots) do
        for _, d in ipairs(root:GetDescendants()) do
            hookRemote(d)
        end
        hold("spyIn", root.DescendantAdded:Connect(hookRemote))
    end
end)

