            end))
        else
            hold("watch", inst.Changed:Connect(function(prop)
                local ok, val = pcall(function() return inst[prop] end)
                emit("監看", p .. "." .. prop .. " = " .. (ok and ser(val) or "?"), p .. "." .. prop)
            end))
        end
        hold("watch", inst.AttributeChanged:Connect(function(n)
            emit("監看", p .. " 屬性 " .. n .. " = " .. ser(inst:GetAttribute(n)), p .. "屬性" .. n)
        end))
        hold("watch", inst.DescendantAdded:Connect(function(d) bump(batchAdd, d) end))
        hold("watch", inst.DescendantRemoving:Connect(function(d) bump(batchRem, d) end))
        push("系統", "開始監看 " .. p)
    end)
end

