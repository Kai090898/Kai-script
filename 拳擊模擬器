local logBuf = {}
local function blog(s)
    table.insert(logBuf, string.format("[%s] %s", os.date("%H:%M:%S"), s))
    if #logBuf > 200 then table.remove(logBuf, 1) end
end

-- 每隔一段時間做一件事：S[name] 為真才會執行
local function every(name, getDelay, fn)
    task.spawn(function()
        while true do
            if S[name] then
                local ok, err = pcall(fn)
                if not ok then
                    blog(name .. " 錯誤：" .. tostring(err))
                    task.wait(1)
                end
                task.wait(math.max(getDelay(), 0.1))
            else
                task.wait(0.3)
            end
        end
    end)
end

