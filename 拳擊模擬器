        local used = false
        if T.hatchMode ~= "事件" then
            local btn = findOpenButton(T.hatchMode == "Open3" and "Open3" or "Open1")
            if btn then
                click(btn)
                used = true
            end
        end
        if not used then
            fire("PlayerPressedKeyOnEgg", egg)
        end
        hatchCount += 1
        status = string.format("已孵蛋 %d 次（%s，%s）", hatchCount, egg, used and "按鈕" or "事件")
        if S.instantOpen then
            task.wait(0.15)
            for _, n in ipairs({"PetOpenUI", "PetOpenUIOLD"}) do
                local g = dig(getPg(), n)
                if g then g.Enabled = false end
            end
        end
    end
    every("hatch", function() return N.hatchDelay end, hatchOnce)
