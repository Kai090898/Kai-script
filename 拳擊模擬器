FarmTab:CreateSection("自動訓練 / 戰鬥（按畫面左下角的按鈕）")
do
    -- 找畫面上有這段文字的按鈕（先找 OnScreenButtons、MainUi，再找全部）
    local function findAutoButton(keywords)
        local pg = getPg()
        if not pg then return end
        local roots = {}
        for _, n in ipairs({"OnScreenButtons", "MainUi"}) do
            local g = pg:FindFirstChild(n)
            if g then table.insert(roots, g) end
        end
        table.insert(roots, pg)
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    for _, kw in ipairs(keywords) do
                        if has(d.Text, kw) and shown(d) then
                            local cur = d
                            while cur and cur ~= pg do
                                if cur:IsA("GuiButton") then return cur end
                                cur = cur.Parent
                            end
                            -- 沒有按鈕祖先：往上找最多三層，看裡面有沒有按鈕
                            local p = d.Parent
                            for _ = 1, 3 do
                                if not p or p == pg then break end
                                for _, c in ipairs(p:GetDescendants()) do
                                    if c:IsA("GuiButton") then return c end
                                end
                                p = p.Parent
                            end
                        end
                    end
                end
            end
        end
    end

    -- true = 開啟、false = 關閉、nil = 看不出來
    local function stateOf(btn)
        for _, d in ipairs(btn:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                if has(d.Text, "開啟") then return true end
                if has(d.Text, "關閉") then return false end
            end
        end
        return nil
    end

    local function ensure(keywords, want, firstTime)
        local btn = findAutoButton(keywords)
        if not btn then
            status = "找不到「" .. keywords[1] .. "」按鈕"
            return
        end
        local st = stateOf(btn)
        if st == nil then
            if firstTime then click(btn) end
        elseif st ~= want then
            click(btn)
        end
    end

    local TRAIN = {"自動訓練", "Auto Train"}
    local FIGHT = {"自動戰鬥", "Auto Fight"}

    addToggle(FarmTab, "自動訓練", "autoTrain", function(v)
        task.spawn(function() pcall(ensure, TRAIN, v, true) end)
    end)
    addToggle(FarmTab, "自動戰鬥", "autoFight", function(v)
        task.spawn(function() pcall(ensure, FIGHT, v, true) end)
    end)
    every("autoTrain", function() return 3 end, function() ensure(TRAIN, true, false) end)
    every("autoFight", function() return 3 end, function() ensure(FIGHT, true, false) end)
end

