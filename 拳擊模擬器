    addToggle(EggTab, "自動孵蛋（要站在蛋旁邊）", "hatch")
    addNumber(EggTab, "孵蛋間隔（秒）", "預設 1.2", "hatchDelay", 0.3)
    addToggle(EggTab, "孵蛋前先傳送到蛋旁邊", "eggTeleport")

    EggTab:CreateButton({
