PetTab:CreateSection("合成寵物")
do
    -- GenerateInventory:InvokeServer() 回傳背包；合成時把「id = 寵物資料」的表送給合成 Remote
    local function collectPets(t, out, depth)
        if type(t) ~= "table" or depth > 4 then return end
        for k, v in pairs(t) do
            if type(v) == "table" then
                if v.name ~= nil and v.petType ~= nil then
                    out[#out + 1] = {id = k, info = v}
                else
                    collectPets(v, out, depth + 1)
                end
            end
        end
    end
    local function readPets()
        local ok, inv = invoke("GenerateInventory")
        if not ok or type(inv) ~= "table" then
            return nil, tostring(inv)
        end
        local list = {}
        collectPets(inv, list, 0)
        return list
    end

    -- 金色 ✔（探測時看過 PlayerGoldenMerge）；彩虹 / 惡魔的 Remote 存在，但沒看過實際合成
    local TIERS = {
        Golden = {remote = "PlayerGoldenMerge", from = "normal"},
        Rainbow = {remote = "PlayerRainbowMerge", from = "golden"},
        Demonic = {remote = "PlayerDemonicMerge", from = "rainbow"},
    }

    local iName = PetTab:CreateInput({
        Name = "要合成的寵物名稱（例如 ArcticFox，輸入 全部 代表所有）",
        PlaceholderText = "先按下面的按鈕看背包裡有哪些",
        Callback = function(text)
            T.petName = tostring(text or "")
            notify("已設定", "寵物 = " .. T.petName)
        end,
    })
    regText("petName", iName, function() return T.petName end, function(v) T.petName = v end)

    local dTier = PetTab:CreateDropdown({
        Name = "合成成",
        Options = {"Golden", "Rainbow", "Demonic"},
        CurrentOption = {T.mergeTier},
        Callback = function(opt)
            T.mergeTier = type(opt) == "table" and opt[1] or opt
        end,
    })
    regDropdown("mergeTier", dTier, function() return T.mergeTier end, function(v) T.mergeTier = v end)

    addNumber(PetTab, "每次合成幾隻（1-6，探測時看過 5 和 3）", "預設 5", "mergeAmount", 1)
    addNumber(PetTab, "每次合成間隔（秒）", "預設 0.6", "mergeDelay", 0.2)

    PetTab:CreateButton({
        Name = "讀取背包（複製各寵物的數量）",
        Callback = function()
            local list, err = readPets()
            if not list then
                notify("讀取失敗", tostring(err), 6)
                return
            end
            local count = {}
            for _, p in ipairs(list) do
                local key = tostring(p.info.name) .. "（" .. tostring(p.info.petType) .. "）"
                count[key] = (count[key] or 0) + 1
            end
            local lines = {}
            for k, c in pairs(count) do
                table.insert(lines, k .. " ×" .. c)
            end
            table.sort(lines)
            local text = table.concat(lines, "\n")
            if setclipboard then pcall(setclipboard, text) end
            notify("背包", "共 " .. #list .. " 隻，名單已複製到剪貼簿", 5)
        end,
    })

    local merging = false
    local tMerge
    tMerge = PetTab:CreateToggle({
        Name = "自動合成寵物（會消耗寵物）",
        CurrentValue = false,
        Callback = function(v)
            S.autoMerge = v
            if not v or merging then return end
            merging = true
            task.spawn(function()
                local tier = TIERS[T.mergeTier] or TIERS.Golden
                local amount = math.clamp(math.floor(N.mergeAmount), 1, 6)
                local name = T.petName
                local rounds = 0
                if name == "" then
                    notify("還沒選寵物", "請先輸入寵物名稱（或輸入 全部）", 6)
                end
                while S.autoMerge and name ~= "" and rounds < 300 do
                    local pets, err = readPets()
                    if not pets then
                        status = "讀取背包失敗：" .. tostring(err)
                        break
                    end
                    local groups = {}
                    for _, p in ipairs(pets) do
                        local i = p.info
                        if tostring(i.petType):lower() == tier.from and not i.equipped
                            and (name == "全部" or i.name == name) then
                            groups[i.name] = groups[i.name] or {}
                            table.insert(groups[i.name], p)
                        end
                    end
                    local did = false
                    for gname, list in pairs(groups) do
                        if #list >= amount then
                            local payload = {}
                            for k = 1, amount do
                                payload[list[k].id] = list[k].info
                            end
                            fire(tier.remote, payload)
                            rounds += 1
                            did = true
                            status = string.format("合成 %s → %s（第 %d 次）", gname, T.mergeTier, rounds)
                            blog(status)
                            task.wait(math.max(N.mergeDelay, 0.2))
                            break
                        end
                    end
                    if not did then
                        status = "沒有足夠的寵物可以合成了（共合成 " .. rounds .. " 次）"
                        break
                    end
                end
                merging = false
                S.autoMerge = false
                pcall(function() tMerge:Set(false) end)
            end)
        end,
    })
end

