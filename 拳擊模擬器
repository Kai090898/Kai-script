-- ===== 小工具 =====
local function notify(title, content, duration)
    UI:Notify({Title = title, Content = content, Duration = duration or 3})
end
local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end
local function has(t, s)
    return t ~= nil and t:find(s, 1, true) ~= nil
end
local function getPg()
    return LocalPlayer:FindFirstChild("PlayerGui")
end
local function dig(root, ...)
    local cur = root
    for _, name in ipairs({...}) do
        cur = cur and cur:FindFirstChild(name)
    end
    return cur
end
local function shown(obj)
    local cur = obj
    while cur do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") then return cur.Enabled end
        cur = cur.Parent
    end
    return false
end

-- Remote：先找 Events 資料夾，再找 ReplicatedStorage 根目錄
local Events = RS:WaitForChild("Events", 10)
local function getRemote(name)
    return (Events and Events:FindFirstChild(name)) or RS:FindFirstChild(name)
end
local function fire(name, ...)
    local r = getRemote(name)
    if r and r:IsA("RemoteEvent") then
        return pcall(r.FireServer, r, ...)
    end
    return false, "找不到 " .. name
end
local function invoke(name, ...)
    local r = getRemote(name)
    if r and r:IsA("RemoteFunction") then
        return pcall(r.InvokeServer, r, ...)
    end
    return false, "找不到 " .. name
end

local function click(btn)
    if getconnections then
        for _, sig in ipairs({btn.Activated, btn.MouseButton1Click}) do
            local ok, conns = pcall(getconnections, sig)
            if ok and conns and #conns > 0 then
                for _, c in ipairs(conns) do
                    pcall(function() c:Fire() end)
                end
                return
            end
        end
    end
    local g = btn:FindFirstAncestorWhichIsA("ScreenGui")
    local inset = Vector2.new(0, 0)
    if g and not g.IgnoreGuiInset then
        inset = GuiService:GetGuiInset()
    end
    local p = btn.AbsolutePosition + btn.AbsoluteSize / 2 + inset
    VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0)
    VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
end

-- ===== 設定存檔（只存這個介面自己的設定；會花資源的開關不存）=====
local CONFIG_FILE = "KaiScript_PunchSim.json"
local reg = {}
local function regToggle(key, el, get)
    table.insert(reg, {key = key, kind = "toggle", el = el, get = get})
end
local function regNumber(key, el, get, set)
    table.insert(reg, {key = key, kind = "number", el = el, get = get, set = set})
end
local function regDropdown(key, el, get, set)
    table.insert(reg, {key = key, kind = "dropdown", el = el, get = get, set = set})
end
local function regText(key, el, get, set)
    table.insert(reg, {key = key, kind = "text", el = el, get = get, set = set})
end

local function saveConfig()
    if not writefile then
        notify("無法儲存", "這個執行器不支援檔案功能")
        return
    end
    local data = {}
    for _, r in ipairs(reg) do
        data[r.key] = r.get()
    end
    local ok, err = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    notify(ok and "已儲存" or "儲存失敗", ok and "拳擊模擬器 AFK 的設定已存檔" or tostring(err))
end

local function loadConfig(quiet)
    if not (isfile and readfile) or not isfile(CONFIG_FILE) then
        if not quiet then notify("沒有存檔", "請先按「儲存設定」") end
        return
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(data) ~= "table" then return end
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil then
            if r.kind == "number" and type(v) == "number" then
                pcall(function() r.set(v) r.el:Set(tostring(v)) end)
            elseif r.kind == "dropdown" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set({v}) end)
            elseif r.kind == "text" and type(v) == "string" then
                pcall(function() r.set(v) r.el:Set(v) end)
            end
        end
    end
    for _, r in ipairs(reg) do
        local v = data[r.key]
        if v ~= nil and r.kind == "toggle" and type(v) == "boolean" then
            pcall(function() r.el:Set(v) end)
        end
    end
    if not quiet then notify("已載入", "設定已套用") end
end

