local function addToggle(tab, label, key, onChange)
    return tab:CreateToggle({
        Name = label,
        CurrentValue = false,
        Callback = function(v)
            S[key] = v
            if onChange then onChange(v) end
        end,
    })
end

local function addNumber(tab, label, placeholder, key, minv)
    local el = tab:CreateInput({
        Name = label,
        PlaceholderText = placeholder,
        Callback = function(text)
            local n = tonumber(text)
            if n and n >= (minv or 0) then
                N[key] = n
                notify("已設定", label .. " = " .. n)
            else
                notify("輸入錯誤", "請輸入 " .. (minv or 0) .. " 以上的數字")
            end
        end,
    })
    regNumber("n_" .. key, el, function() return N[key] end, function(v) N[key] = v end)
    return el
end

