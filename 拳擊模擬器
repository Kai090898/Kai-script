    -- PetsPopup 上的 Open1 / Open3 按鈕（靠近蛋時才會出現）
    local function findOpenButton(name)
        local b = dig(getPg(), "PetsPopup", "Frame", name)
        if b and shown(b) then return b end
    end

    local function hatchOnce()
        local egg = (T.eggCustom ~= "" and T.eggCustom) or T.egg
        if S.eggTeleport then
            local vend = dig(workspace, "EggVendors", egg)
            local root = getRoot()
            if vend and root then
                local ok, pivot = pcall(function() return vend:GetPivot() end)
                if ok and (root.Position - pivot.Position).Magnitude > 12 then
                    root.CFrame = CFrame.new(pivot.Position + Vector3.new(0, 4, 0))
