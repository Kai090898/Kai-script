EggTab:CreateSection("開蛋動畫（避免越開越卡）")
do
    -- 記下開蛋介面「原本就有」的東西，之後新長出來的（動畫複製品）過一陣子就清掉
    local baseline = {}
    local born = {}
    local hooked = {}

    local function hookUI(g)
        if hooked[g] then return end
        hooked[g] = true
        for _, d in ipairs(g:GetDescendants()) do
            baseline[d] = true
        end
        g.DescendantAdded:Connect(function(d)
            if not baseline[d] then
                born[d] = tick()
            end
        end)
        g.AncestryChanged:Connect(function()
            if not g.Parent then hooked[g] = nil end
        end)
    end

    local function hookAll()
        for _, n in ipairs({"PetOpenUI", "PetOpenUIOLD"}) do
            local g = dig(getPg(), n)
            if g then hookUI(g) end
        end
    end
    hookAll()

    local removed = 0
    local function clean(maxAge)
        hookAll()
        local now = tick()
        for d, t in pairs(born) do
            if not d.Parent then
                born[d] = nil
            elseif now - t >= maxAge then
                born[d] = nil
                pcall(function() d:Destroy() end)
                removed += 1
            end
        end
    end

    addToggle(EggTab, "清除開蛋動畫殘留", "cleanHatch")
    addNumber(EggTab, "動畫保留幾秒後清除", "預設 3，越小越乾淨，但太小會把正在播的動畫弄壞", "cleanAge", 0.5)
    addToggle(EggTab, "瞬間開蛋（開完立刻關掉開蛋畫面）", "instantOpen")
    every("cleanHatch", function() return 1 end, function()
        clean(N.cleanAge)
    end)

    EggTab:CreateButton({
        Name = "立刻清除全部殘留",
        Callback = function()
            clean(0)
            notify("開蛋動畫", "已清除，累計清掉 " .. removed .. " 個物件", 4)
        end,
    })
end

