local useEnglish = false
local langItems = {}

local function trText(zh)
    return (useEnglish and EN[zh]) or zh
end

local function addLang(el, zh, placeholder)
    if el and zh then
        table.insert(langItems, {el = el, zh = zh, ph = placeholder})
    end
end

local function applyLang()
    pcall(function()
        Window:SetTitle(trText("卡依腳本"))
    end)
    for _, it in ipairs(langItems) do
        pcall(function()
            it.el:SetName(trText(it.zh))
            if it.ph and it.el.SetPlaceholder then
                it.el:SetPlaceholder(trText(it.ph))
            end
        end)
    end
end

-- 包裝建立函式：之後建立的每個項目都會自動登記，方便切換語言
local function wrapTab(tab)
    for _, m in ipairs({"CreateToggle", "CreateButton", "CreateInput", "CreateDropdown"}) do
        local f = tab[m]
        tab[m] = function(self, o)
            local el = f(self, o)
            addLang(el, o.Name, o.PlaceholderText)
            return el
        end
    end
    local fs = tab.CreateSection
    tab.CreateSection = function(self, text)
        local el = fs(self, text)
        addLang(el, text)
        return el
    end
    return tab
end

do
    local origCreateTab = Window.CreateTab
    Window.CreateTab = function(self, name)
        local t = origCreateTab(self, name)
        addLang(t, name)
        return wrapTab(t)
    end
end

