-- ----- 防被撞飛（角色透明、別人碰不到） -----
local ANTI_FLING_TRANSPARENCY = 0.6

local function restoreAntiFling()
    for p in pairs(antiFlingParts) do
        if p.Parent then
            -- 如果穿牆還開著，碰撞交給穿牆處理
            if not noclipOn then
                p.CanCollide = true
            end
        end
    end
    antiFlingParts = {}
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = 0
            end
        end
    end
end

-- ----- 玩家透視（ESP）-----
local espData = {}
local espFolder = nil

local function getEspFolder()
    if not espFolder or not espFolder.Parent then
        espFolder = Instance.new("Folder")
        espFolder.Name = "KaiEsp"
        parentSafe(espFolder)
    end
    return espFolder
end

local function removeEsp(plr)
    local d = espData[plr]
    if d then
        if d.gui then d.gui:Destroy() end
        if d.hl then d.hl:Destroy() end
        espData[plr] = nil
    end
end

local function clearEsp()
    for plr in pairs(espData) do
        removeEsp(plr)
    end
end

local function createEspGui()
    local gui = Instance.new("BillboardGui")
    gui.Name = "KaiEspGui"
    gui.Size = UDim2.new(0, 160, 0, 40)
    gui.StudsOffset = Vector3.new(0, 2.8, 0)
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.ResetOnSpawn = false
    gui.Parent = getEspFolder()

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextStrokeTransparency = 0
    label.Text = ""
    label.Parent = gui
    return gui, label
end

local function createEspHighlight()
    local hl = Instance.new("Highlight")
    hl.Name = "KaiEspHl"
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.Parent = getEspFolder()
    return hl
end

local function updateEsp()
    local myRoot = getRoot()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local sameTeam = espHideTeam and plr.Team ~= nil and plr.Team == LocalPlayer.Team

            if head and hum and hum.Health > 0 and not sameTeam then
                local d = espData[plr]
                if not d then
                    d = {}
                    espData[plr] = d
                end
                local color = plr.Team and plr.TeamColor.Color or Color3.fromRGB(255, 70, 70)

                if espTextOn then
                    if not d.gui then
                        d.gui, d.label = createEspGui()
                    end
                    d.gui.Adornee = head
                    d.label.TextColor3 = color
                    local dist = myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0
                    d.label.Text = string.format("%s\n距離 %d｜HP %d", plr.DisplayName, dist, math.floor(hum.Health))
                elseif d.gui then
                    d.gui:Destroy()
                    d.gui = nil
                    d.label = nil
                end

                if espHlOn then
                    if not d.hl then
                        d.hl = createEspHighlight()
                    end
                    d.hl.Adornee = char
                    d.hl.FillColor = color
                    d.hl.OutlineColor = Color3.new(1, 1, 1)
                elseif d.hl then
                    d.hl:Destroy()
                    d.hl = nil
                end
            else
                removeEsp(plr)
            end
        end
    end
end

local espAcc = 0
RunService.Heartbeat:Connect(function(dt)
    if not (espTextOn or espHlOn) then
        return
    end
    espAcc += dt
    if espAcc < 0.1 then
        return
    end
    espAcc = 0
    pcall(updateEsp)
end)

