local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- ========== 自動點擊設定 ==========
local enabled = false
local shortcutEnabled = false  -- 雙擊捷徑預設關閉
local unit = "毫秒"
local value = 100
local interval = 0.1

local lastAutoClick = 0
local lastTap = 0
local DOUBLE_TAP_TIME = 0.4

local function updateInterval()
    if unit == "秒" then
        interval = value
    else
        interval = value / 1000
    end
    if interval < 0.001 then interval = 0.001 end
end

local function getCenter()
    local size = workspace.CurrentCamera.ViewportSize
    return size.X / 2, size.Y / 2
end

local function click()
    local x, y = getCenter()
    lastAutoClick = tick()
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    if not ok and mousemoveabs and mouse1click then
        mousemoveabs(x, y)
        mouse1click()
    end
end

task.spawn(function()
    while true do
        if enabled then
            pcall(click)
            task.wait(interval)
        else
            task.wait(0.1)
        end
    end
end)

-- ========== 修改器設定 ==========
local speedOn, speedVal = false, 50
local jumpOn, jumpVal = false, 100
local brightOn, brightVal = false, 2
local fogOn = false
local filterOn = false

local orig = {}          -- 原始數值
local filterOrig = {}    -- 濾鏡原本的開關狀態

local function getHumanoid()
    local char = Players.LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- 去霧：把霧推到極遠，Atmosphere 的濃度與霧氣歸零
local function applyNoFog()
    Lighting.FogStart = 1e9
    Lighting.FogEnd = 1e9
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            v.Density = 0
            v.Haze = 0
        end
    end
end

local function saveFog()
    orig.FogStart = Lighting.FogStart
    orig.FogEnd = Lighting.FogEnd
    orig.atmos = {}
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            orig.atmos[v] = {Density = v.Density, Haze = v.Haze}
        end
    end
end

local function restoreFog()
    if orig.FogStart then
        Lighting.FogStart = orig.FogStart
        Lighting.FogEnd = orig.FogEnd
    end
    if orig.atmos then
        for v, d in pairs(orig.atmos) do
            if v.Parent then
                v.Density = d.Density
                v.Haze = d.Haze
            end
        end
    end
    orig.atmos = nil
end

-- 去濾鏡：關閉所有後製特效（模糊、色彩校正、光暈、光線、景深）
local function disableFilters()
    local roots = {Lighting}
    if workspace.CurrentCamera then
        table.insert(roots, workspace.CurrentCamera)
    end
    for _, root in ipairs(roots) do
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("PostEffect") then
                if filterOrig[v] == nil then
                    filterOrig[v] = v.Enabled
                end
                v.Enabled = false
            end
        end
    end
end

local function restoreFilters()
    for v, e in pairs(filterOrig) do
        if v.Parent then
            v.Enabled = e
        end
    end
    filterOrig = {}
end

-- 每幀套用數值（遊戲把數值改回去時會自動再改回來）
RunService.Heartbeat:Connect(function()
    local hum = getHumanoid()
    if hum then
        if speedOn then
            hum.WalkSpeed = speedVal
        end
        if jumpOn then
            hum.UseJumpPower = true
            hum.JumpPower = jumpVal
        end
    end
    if brightOn then
        Lighting.Brightness = brightVal
    end
    if fogOn then
        applyNoFog()
    end
end)

-- 濾鏡可能中途被遊戲新增，所以定時檢查
task.spawn(function()
    while true do
        if filterOn then
            pcall(disableFilters)
        end
        task.wait(0.5)
    end
end)

