-- 點擊傳送（輕點才會傳送，拖曳轉視角不會）
local tapStart = {}

UIS.InputBegan:Connect(function(input, processed)
    if not clickTpOn or processed then
        return
    end
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        if tick() - lastAutoClick < 0.05 then
            return
        end
        tapStart[input] = {
            pos = Vector2.new(input.Position.X, input.Position.Y),
            time = tick(),
            touch = (t == Enum.UserInputType.Touch),
        }
    end
end)

UIS.InputEnded:Connect(function(input)
    local info = tapStart[input]
    if not info then
        return
    end
    tapStart[input] = nil
    if not clickTpOn then
        return
    end

    local endPos = Vector2.new(input.Position.X, input.Position.Y)
    if tick() - info.time > 0.3 or (endPos - info.pos).Magnitude > 15 then
        return
    end

    local cam = workspace.CurrentCamera
    local root = getRoot()
    if not cam or not root then
        return
    end

    local ray
    if info.touch then
        ray = cam:ScreenPointToRay(endPos.X, endPos.Y)
    else
        local m = UIS:GetMouseLocation()
        ray = cam:ViewportPointToRay(m.X, m.Y)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}

    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if result then
        root.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
    end
end)

-- ----- 重新加入 / 換伺服器 -----
local function rejoin()
    if #Players:GetPlayers() <= 1 then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

local function serverHop()
    local ok, found = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                return true
            end
        end
        return false
    end)
    if not ok or not found then
        notify("換伺服器失敗", "找不到可加入的其他伺服器")
    end
end

