-- ----- 重新加入 / 換伺服器 -----
local function rejoin()
    if #Players:GetPlayers() <= 1 then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

local function serverHop()
    local ok, found = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                return true
            end
        end
        return false
    end)
    if not ok or not found then
        notify("換伺服器失敗", "找不到可加入的其他伺服器")
    end
end

-- 每幀套用數值（遊戲把數值改回去時會自動再改回來）
RunService.Heartbeat:Connect(function()
    local hum = getHumanoid()
    if hum then
        if speedOn then
            hum.WalkSpeed = speedVal
        end
        if jumpOn then
            hum.UseJumpPower = true
            hum.JumpPower = jumpVal
        end
    end
    if brightOn then
        Lighting.Brightness = brightVal
    end
    if fogOn then
        applyNoFog()
    end
    if gravOn then
        workspace.Gravity = gravVal
    end

    -- 飛行
    if flyOn then
        local root = getRoot()
        local cam = workspace.CurrentCamera
        if root and hum and cam then
            if not flyBV or flyBV.Parent ~= root then
                if flyBV then flyBV:Destroy() end
                flyBV = Instance.new("BodyVelocity")
                flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                flyBV.Velocity = Vector3.zero
                flyBV.Parent = root
            end
            local cf = cam.CFrame
            local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local flatRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            local move = hum.MoveDirection
            local f, s = 0, 0
            if flatLook.Magnitude > 0.01 then f = move:Dot(flatLook.Unit) end
            if flatRight.Magnitude > 0.01 then s = move:Dot(flatRight.Unit) end
            flyBV.Velocity = (cf.LookVector * f + cf.RightVector * s) * flyVal
        end
    end
end)

