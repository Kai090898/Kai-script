-- ----- 去霧 -----
local function applyNoFog()
    Lighting.FogStart = 1e9
    Lighting.FogEnd = 1e9
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            v.Density = 0
            v.Haze = 0
        end
    end
end

local function saveFog()
    orig.FogStart = Lighting.FogStart
    orig.FogEnd = Lighting.FogEnd
    orig.atmos = {}
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            orig.atmos[v] = {Density = v.Density, Haze = v.Haze}
        end
    end
end

local function restoreFog()
    if orig.FogStart then
        Lighting.FogStart = orig.FogStart
        Lighting.FogEnd = orig.FogEnd
    end
    if orig.atmos then
        for v, d in pairs(orig.atmos) do
            if v.Parent then
                v.Density = d.Density
                v.Haze = d.Haze
            end
        end
    end
    orig.atmos = nil
end

-- ----- 去濾鏡 -----
local function disableFilters()
    local roots = {Lighting}
    if workspace.CurrentCamera then
        table.insert(roots, workspace.CurrentCamera)
    end
    for _, root in ipairs(roots) do
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("PostEffect") then
                if filterOrig[v] == nil then
                    filterOrig[v] = v.Enabled
                end
                v.Enabled = false
            end
        end
    end
end

local function restoreFilters()
    for v, e in pairs(filterOrig) do
        if v.Parent then
            v.Enabled = e
        end
    end
    filterOrig = {}
end

-- ----- FPS 提升 -----
local boostClasses = {"ParticleEmitter", "Trail", "Beam", "Smoke", "Fire", "Sparkles"}

local function boostCheck(v)
    for _, c in ipairs(boostClasses) do
        if v:IsA(c) then
            if boostOrig[v] == nil then
                boostOrig[v] = v.Enabled
            end
            v.Enabled = false
            return
        end
    end
end

local function boostStart()
    orig.Shadows = Lighting.GlobalShadows
    Lighting.GlobalShadows = false
    pcall(function()
        orig.Quality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    for _, v in ipairs(workspace:GetDescendants()) do
        boostCheck(v)
    end
    boostConn = workspace.DescendantAdded:Connect(boostCheck)
end

local function boostStop()
    if boostConn then
        boostConn:Disconnect()
        boostConn = nil
    end
    if orig.Shadows ~= nil then
        Lighting.GlobalShadows = orig.Shadows
    end
    pcall(function()
        if orig.Quality then
            settings().Rendering.QualityLevel = orig.Quality
        end
    end)
    for v, e in pairs(boostOrig) do
        if v.Parent then
            v.Enabled = e
        end
    end
    boostOrig = {}
end

-- ----- 靜音 -----
local function muteCheck(v)
    if v:IsA("Sound") then
        if muteOrig[v] == nil then
            muteOrig[v] = v.Volume
        end
        v.Volume = 0
    end
end

local function muteStart()
    for _, v in ipairs(game:GetDescendants()) do
        pcall(muteCheck, v)
    end
    muteConn = game.DescendantAdded:Connect(function(v)
        pcall(muteCheck, v)
    end)
end

local function muteStop()
    if muteConn then
        muteConn:Disconnect()
        muteConn = nil
    end
    for v, vol in pairs(muteOrig) do
        if v.Parent then
            v.Volume = vol
        end
    end
    muteOrig = {}
end

task.spawn(function()
    while true do
        if muteOn then
            for v in pairs(muteOrig) do
                if v.Parent then
                    if v.Volume ~= 0 then v.Volume = 0 end
                else
                    muteOrig[v] = nil
                end
            end
        end
        task.wait(0.5)
    end
end)

