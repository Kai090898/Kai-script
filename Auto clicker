-- ----- 去霧 -----
local function applyNoFog()
    Lighting.FogStart = 1e9
    Lighting.FogEnd = 1e9
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            v.Density = 0
            v.Haze = 0
        end
    end
end

local function saveFog()
    orig.FogStart = Lighting.FogStart
    orig.FogEnd = Lighting.FogEnd
    orig.atmos = {}
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            orig.atmos[v] = {Density = v.Density, Haze = v.Haze}
        end
    end
end

local function restoreFog()
    if orig.FogStart then
        Lighting.FogStart = orig.FogStart
        Lighting.FogEnd = orig.FogEnd
    end
    if orig.atmos then
        for v, d in pairs(orig.atmos) do
            if v.Parent then
                v.Density = d.Density
                v.Haze = d.Haze
            end
        end
    end
    orig.atmos = nil
end

-- ----- 去濾鏡 -----
local function disableFilters()
    local roots = {Lighting}
    if workspace.CurrentCamera then
        table.insert(roots, workspace.CurrentCamera)
    end
    for _, root in ipairs(roots) do
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("PostEffect") then
                if filterOrig[v] == nil then
                    filterOrig[v] = v.Enabled
                end
                v.Enabled = false
            end
        end
    end
end

local function restoreFilters()
    for v, e in pairs(filterOrig) do
        if v.Parent then
            v.Enabled = e
        end
    end
    filterOrig = {}
end

-- ----- FPS 提升 -----
local boostClasses = {"ParticleEmitter", "Trail", "Beam", "Smoke", "Fire", "Sparkles"}

local function boostCheck(v)
    for _, c in ipairs(boostClasses) do
        if v:IsA(c) then
            if boostOrig[v] == nil then
                boostOrig[v] = v.Enabled
            end
            v.Enabled = false
            return
        end
    end
end

local function boostStart()
    orig.Shadows = Lighting.GlobalShadows
    Lighting.GlobalShadows = false
    pcall(function()
        orig.Quality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    for _, v in ipairs(workspace:GetDescendants()) do
        boostCheck(v)
    end
    boostConn = workspace.DescendantAdded:Connect(boostCheck)
end

local function boostStop()
    if boostConn then
        boostConn:Disconnect()
        boostConn = nil
    end
    if orig.Shadows ~= nil then
        Lighting.GlobalShadows = orig.Shadows
    end
    pcall(function()
        if orig.Quality then
            settings().Rendering.QualityLevel = orig.Quality
        end
    end)
    for v, e in pairs(boostOrig) do
        if v.Parent then
            v.Enabled = e
        end
    end
    boostOrig = {}
end

-- ----- 飛行 -----
local function stopFly()
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
    local root = getRoot()
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
    end
end

-- ----- 穿牆 -----
local function restoreNoclip()
    for p in pairs(noclipParts) do
        if p.Parent then
            p.CanCollide = true
        end
    end
    noclipParts = {}
end

-- 每幀套用數值（遊戲把數值改回去時會自動再改回來）
RunService.Heartbeat:Connect(function()
    local hum = getHumanoid()
    if hum then
        if speedOn then
            hum.WalkSpeed = speedVal
        end
        if jumpOn then
            hum.UseJumpPower = true
            hum.JumpPower = jumpVal
        end
    end
    if brightOn then
        Lighting.Brightness = brightVal
    end
    if fogOn then
        applyNoFog()
    end
    if gravOn then
        workspace.Gravity = gravVal
    end

    -- 飛行
    if flyOn then
        local root = getRoot()
        local cam = workspace.CurrentCamera
        if root and hum and cam then
            if not flyBV or flyBV.Parent ~= root then
                if flyBV then flyBV:Destroy() end
                flyBV = Instance.new("BodyVelocity")
                flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                flyBV.Velocity = Vector3.zero
                flyBV.Parent = root
            end
            local cf = cam.CFrame
            local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local flatRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            local move = hum.MoveDirection
            local f, s = 0, 0
            if flatLook.Magnitude > 0.01 then f = move:Dot(flatLook.Unit) end
            if flatRight.Magnitude > 0.01 then s = move:Dot(flatRight.Unit) end
            flyBV.Velocity = (cf.LookVector * f + cf.RightVector * s) * flyVal
        end
    end
end)

