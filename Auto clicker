-- ----- 防掉虛空 -----
local function getVoidY()
    local fh = workspace.FallenPartsDestroyHeight
    -- 有些地圖把它設成極小值或 NaN，這時改用預設的 -500
    if fh ~= fh or fh < -1e5 then
        fh = -500
    end
    return fh + 80  -- 在被系統清掉之前就先救回來
end

RunService.Heartbeat:Connect(function()
    if not antiVoidOn then
        return
    end
    local root = getRoot()
    local hum = getHumanoid()
    if not (root and hum) or hum.Health <= 0 then
        return
    end

    -- 站在地面上時，每 0.25 秒記錄一次安全位置
    if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > getVoidY() + 20 then
        if tick() - lastSafeSave > 0.25 then
            lastSafeSave = tick()
            safePos = root.Position
        end
    end

    -- 掉到虛空高度以下 → 傳回安全位置
    if root.Position.Y < getVoidY() and tick() - lastVoidTp > 1 then
        lastVoidTp = tick()
        local target = safePos
        if not target then
            local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
            target = spawn and (spawn.Position + Vector3.new(0, 3, 0))
        end
        if target then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(target + Vector3.new(0, 5, 0))
            notify("防掉虛空", "已把你傳回安全位置", 2)
        end
    end
end)

