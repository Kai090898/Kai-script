-- 點擊傳送（輕點才會傳送，拖曳轉視角不會）
local tapStart = {}

UIS.InputBegan:Connect(function(input, processed)
    if not clickTpOn or processed then
        return
    end
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        if tick() - lastAutoClick < 0.05 then
            return
        end
        tapStart[input] = {
            pos = Vector2.new(input.Position.X, input.Position.Y),
            time = tick(),
            touch = (t == Enum.UserInputType.Touch),
        }
    end
end)

UIS.InputEnded:Connect(function(input)
    local info = tapStart[input]
    if not info then
        return
    end
    tapStart[input] = nil
    if not clickTpOn then
        return
    end

    local endPos = Vector2.new(input.Position.X, input.Position.Y)
    if tick() - info.time > 0.3 or (endPos - info.pos).Magnitude > 15 then
        return
    end

    local cam = workspace.CurrentCamera
    local root = getRoot()
    if not cam or not root then
        return
    end

    local ray
    if info.touch then
        ray = cam:ScreenPointToRay(endPos.X, endPos.Y)
    else
        local m = UIS:GetMouseLocation()
        ray = cam:ViewportPointToRay(m.X, m.Y)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}

    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if result then
        root.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
    end
end)

-- ========== 設定存檔 ==========
local CONFIG_FILE = "KaiScript_Config.json"
local reg = {}  -- 要存檔的項目

local function regToggle(key, el, get)
    table.insert(reg, {key = key, kind = "toggle", el = el, get = get})
end

local function regNumber(key, el, get, set)
    table.insert(reg, {key = key, kind = "number", el = el, get = get, set = set})
end

local function regDropdown(key, el, get, set)
    table.insert(reg, {key = key, kind = "dropdown", el = el, get = get, set = set})
end

local function readConfig()
    if not (isfile and readfile) then
        return nil
    end
    local ok, data = pcall(function()
        if isfile(CONFIG_FILE) then
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end
    end)
    if ok and type(data) == "table" then
        return data
    end
    return nil
end

local function saveConfig()
    if not (writefile and readfile and isfile) then
        notify("無法儲存", "這個執行器不支援檔案功能")
        return
    end

    local data = readConfig() or {}
    data.settings = {}
    for _, r in ipairs(reg) do
        data.settings[r.key] = r.get()
    end

    data.places = data.places or {}
    local pts = {}
    for _, p in ipairs(points) do
        table.insert(pts, {n = p.name, x = p.pos.X, y = p.pos.Y, z = p.pos.Z})
    end
    data.places[tostring(game.PlaceId)] = pts

    local ok, err = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    if ok then
        notify("已儲存", "目前設定與位置點已存檔")
    else
        notify("儲存失敗", tostring(err))
    end
end

local function loadConfig(quiet)
    local data = readConfig()
    if not data then
        if not quiet then
            notify("沒有存檔", "請先按「儲存設定」")
        end
        return
    end

    silent = true
    local s = data.settings or {}

    -- 先套用數字和選項，再套用開關
    for _, r in ipairs(reg) do
        local v = s[r.key]
        if v ~= nil and r.kind == "number" and type(v) == "number" then
            pcall(function()
                r.set(v)
                r.el:Set(tostring(v))
            end)
        elseif v ~= nil and r.kind == "dropdown" and type(v) == "string" then
            pcall(function()
                r.set(v)
                r.el:Set({v})
            end)
        end
    end
    for _, r in ipairs(reg) do
        local v = s[r.key]
        if v ~= nil and r.kind == "toggle" and type(v) == "boolean" then
            pcall(function()
                r.el:Set(v)
            end)
        end
    end

    -- 這個遊戲的位置點
    local pts = data.places and data.places[tostring(game.PlaceId)]
    if type(pts) == "table" then
        points = {}
        for _, p in ipairs(pts) do
            if p.n and p.x and p.y and p.z then
                table.insert(points, {name = p.n, pos = Vector3.new(p.x, p.y, p.z)})
            end
        end
        selectedPoint = nil
        pcall(function()
            PointDropdown:Set({})
        end)
        refreshPoints()
    end

    silent = false
    if not quiet then
        notify("已載入", "設定已套用")
    end
end

