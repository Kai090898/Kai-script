-- 快速點擊兩下螢幕 = 開關自動點擊（需先開啟「啟用雙擊開關捷徑」）
UIS.InputBegan:Connect(function(input)
    if not shortcutEnabled then
        return
    end

    local t = input.UserInputType
    if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
        return
    end

    local now = tick()
    if now - lastAutoClick < 0.05 then
        return
    end

    if now - lastTap <= DOUBLE_TAP_TIME then
        lastTap = 0
        Toggle:Set(not enabled)
    else
        lastTap = now
    end
end)

updateInterval()

Rayfield:Notify({
    Title = "卡依腳本",
    Content = "載入完成，請先在介面中開啟需要的功能",
    Duration = 4,
})
