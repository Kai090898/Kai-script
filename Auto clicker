-- 載入設定時暫時關閉通知，避免一直跳
local silent = false
local function notify(title, content, duration)
    if silent then return end
    UI:Notify({Title = title, Content = content, Duration = duration or 3})
end

-- 把物件放到不會被遊戲清掉的地方
local function parentSafe(inst)
    local ok = pcall(function()
        inst.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if not ok or not inst.Parent then
        inst.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- ========== 自動點擊設定 ==========
local enabled = false
local shortcutEnabled = false  -- 雙擊捷徑預設關閉
local unit = "毫秒"
local value = 100
local interval = 0.1

local lastAutoClick = 0
local lastTap = 0
local lastWarn = 0
local DOUBLE_TAP_TIME = 0.4

local function updateInterval()
    if unit == "秒" then
        interval = value
    else
        interval = value / 1000
    end
    if interval < 0.001 then interval = 0.001 end
end

local function getCenter()
    local size = workspace.CurrentCamera.ViewportSize
    return size.X / 2, size.Y / 2
end

local function click()
    local x, y = getCenter()

    -- 選單蓋住螢幕中央時不點，避免點到自己的介面
    if UI:IsOverMenu(x, y) then
        if tick() - lastWarn > 5 then
            lastWarn = tick()
            notify("自動點擊暫停", "選單擋住了螢幕中央，請先隱藏選單或把它拖開")
        end
        return
    end

    lastAutoClick = tick()
    local ok = pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    if not ok and mousemoveabs and mouse1click then
        mousemoveabs(x, y)
        mouse1click()
    end
end

task.spawn(function()
    while true do
        if enabled then
            pcall(click)
            task.wait(interval)
        else
            task.wait(0.1)
        end
    end
end)

