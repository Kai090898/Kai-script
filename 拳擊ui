-- ===== 要做的事（錄製時照這個順序操作）=====
local TASKS = {
    "① 自動訓練：按一次「自動訓練」，或手動訓練幾下",
    "② 飛升一次",
    "③ 轉一次轉盤",
    "④ 領一次遊玩禮物 / 任務",
    "⑤ 開蛋：Open 開 3 次、Open 3 開 2 次",
    "⑥ 合成一次裝備（Craft）",
    "⑦ 買一次裝備",
    "⑧ 許願井許一次願",
    "⑨ 合成一次寵物（Merge）",
    "⑩ 傳送到別的地點一次",
}
local taskDone = {}
local taskToggles = {}

-- ===== 設定 =====
local duration = 180      -- 錄製總秒數
local tailSecs = 20       -- 最後幾秒什麼都不要做（讓殘留的動畫物件顯示出來）

-- ===== 錄製狀態 =====
local alive = true
local recording = false
local startAt, endAt, runId = 0, 0, 0
local runTail = 0
local tailNotified = false
local lastReport = nil

local out = {}
local calls = {}
local born = setmetatable({}, {__mode = "k"})
local conns = {}

local function log(s)
    table.insert(out, s)
end

-- ===== 把參數轉成文字 =====
local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then
        return '"' .. v:sub(1, 60) .. '"'
    elseif t == "table" then
        if d >= 2 then return "{…}" end
        local parts, c = {}, 0
        for k, x in pairs(v) do
            c += 1
            if c > 8 then
                table.insert(parts, "…")
                break
            end
            table.insert(parts, tostring(k) .. "=" .. ser(x, d + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    elseif t == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return "<" .. (ok and name or "?") .. ">"
    end
    return tostring(v)
end

local function record(remote, method, args)
    local key = remote:GetFullName()
    local e = calls[key]
    if not e then
        e = {cls = remote.ClassName, method = method, count = 0, samples = {}, first = tick() - startAt}
        calls[key] = e
    end
    e.count += 1
    if #e.samples < 4 then
        local parts = {}
        for i = 1, args.n do
            parts[i] = ser(args[i])
        end
        local s = table.concat(parts, ", ")
        for _, x in ipairs(e.samples) do
            if x == s then return end
        end
        table.insert(e.samples, s)
    end
end

-- ===== 監聽送出的 Remote（只在錄製中才記錄；按下開始錄製時才安裝）=====
local spyOn = false
local spyTried = false
local spyError = nil

local function installSpy()
    if spyTried then
        return
    end
    spyTried = true
    if not (hookmetamethod and getnamecallmethod and newcclosure) then
        spyError = "這個執行器不支援 hookmetamethod"
        return
    end
    local ok, err = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if recording then
                local m = getnamecallmethod()
                if (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
                    pcall(function()
                        if typeof(self) == "Instance" and self.ClassName:find("Remote") then
                            record(self, m, table.pack(...))
                        end
                    end)
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then
        spyOn = true
    else
        spyError = tostring(err)
    end
end

-- ===== 開始時：介面和 Remote 清單 =====
local function snapshot()
    log("===== PlayerGui 介面 =====")
    for _, g in ipairs(pg:GetChildren()) do
        log(g.Name .. " [" .. g.ClassName .. "]" .. (g:IsA("ScreenGui") and (" Enabled=" .. tostring(g.Enabled)) or ""))
    end

    log("\n===== ReplicatedStorage 裡的 Remote / Bindable（最多 300 個）=====")
    local n = 0
    for _, v in ipairs(RS:GetDescendants()) do
        if v.ClassName:find("Remote") or v:IsA("BindableEvent") or v:IsA("BindableFunction") then
            n += 1
            if n <= 300 then
                log(v:GetFullName() .. " [" .. v.ClassName .. "]")
            end
        end
    end
    log("共 " .. n .. " 個")

    log("\n===== workspace 最上層（最多 80 個）=====")
    for i, c in ipairs(workspace:GetChildren()) do
        if i > 80 then break end
        log(c.Name .. " [" .. c.ClassName .. "]")
    end
end

-- ===== 追蹤新出現的物件（找開蛋動畫的殘留）=====
local function startTracking()
    born = setmetatable({}, {__mode = "k"})
    local function track(root, label)
        table.insert(conns, root.DescendantAdded:Connect(function(d)
            born[d] = {t = tick(), label = label}
        end))
    end
    track(pg, "PlayerGui")
    track(workspace, "Workspace")
    if workspace.CurrentCamera then
        track(workspace.CurrentCamera, "Camera")
    end
end

local function stopTracking()
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
end

-- ===== 結束時整理報告 =====
local function finish(reason)
    if not recording then
        return
    end
    recording = false
    runId += 1

    -- 開頭：這次錄製的資訊和你有做的項目（方便對照）
    local head = {}
    table.insert(head, "===== 錄製資訊 =====")
    table.insert(head, string.format("設定 %d 秒｜實際錄了 %.0f 秒｜結束原因：%s", duration, tick() - startAt, reason))
    table.insert(head, "你勾選「已完成」的項目：")
    local anyDone = false
    for i, name in ipairs(TASKS) do
        if taskDone[i] then
            anyDone = true
            table.insert(head, "  ✔ " .. name)
        end
    end
    if not anyDone then
        table.insert(head, "  （沒有勾選任何項目）")
    end
    table.insert(head, "")

    if spyOn then
        log("\n===== 你操作時送出的 Remote（次數多的在前）=====")
        local list = {}
        for key, e in pairs(calls) do
            table.insert(list, {key = key, e = e})
        end
        table.sort(list, function(a, b) return a.e.count > b.e.count end)
        if #list == 0 then
            log("（錄製期間沒有記錄到任何送出的 Remote）")
        end
        for i, it in ipairs(list) do
            if i > 70 then break end
            log(string.format("\n%s [%s:%s] 共%d次 首次在%.0f秒", it.key, it.e.cls, it.e.method, it.e.count, it.e.first))
            for _, s in ipairs(it.e.samples) do
                log("   參數：" .. s)
            end
        end
    else
        log("\n（沒辦法監聽送出的 Remote：" .. tostring(spyError) .. "）")
    end

    log("\n===== 存活超過 8 秒的新物件（數量多的在前）=====")
    local groups = {}
    local now = tick()
    for d, info in pairs(born) do
        if now - info.t > 8 and d:IsDescendantOf(game) then
            local ok, full = pcall(function() return d:GetFullName() end)
            if ok then
                local key = info.label .. "｜" .. full:gsub("%d+", "#") .. " [" .. d.ClassName .. "]"
                groups[key] = (groups[key] or 0) + 1
            end
        end
    end
    local gl = {}
    for k, c in pairs(groups) do
        table.insert(gl, {k = k, c = c})
    end
    table.sort(gl, function(a, b) return a.c > b.c end)
    if #gl == 0 then
        log("（沒有）")
    end
    for i, g in ipairs(gl) do
        if i > 45 then break end
        log(string.format("%d × %s", g.c, g.k))
    end
    stopTracking()
    born = setmetatable({}, {__mode = "k"})

    local text = table.concat(head, "\n") .. "\n" .. table.concat(out, "\n")
    lastReport = text

    local copied = setclipboard and pcall(setclipboard, text)
    local saved = writefile and pcall(writefile, "KaiPunchProbe.txt", text)
    local msg
    if copied and saved then
        msg = "已複製到剪貼簿，也存成 KaiPunchProbe.txt"
    elseif copied then
        msg = "已複製到剪貼簿"
    elseif saved then
        msg = "已存成 KaiPunchProbe.txt（這個執行器不能複製）"
    else
        msg = "這個執行器不能複製也不能存檔，請看 F9 輸出"
        print(text)
    end
    notify("錄製完成（" .. reason .. "）", msg, 8)
end

-- ===== 開始錄製 =====
local function startRecording()
    if recording then
        notify("已經在錄製了", "要提早結束請按「停止並輸出」")
        return
    end
    installSpy()
    if not spyOn then
        notify("提醒", "沒辦法監聽送出的 Remote，只能記錄介面和殘留物件（" .. tostring(spyError) .. "）", 8)
    end
    out, calls = {}, {}
    startAt = tick()
    endAt = startAt + duration
    runTail = math.min(tailSecs, math.max(duration - 5, 0))
    tailNotified = false
    runId += 1
    local id = runId

    snapshot()
    startTracking()
    recording = true

    notify("開始錄製",
        string.format("共 %d 秒，請照「要做的事」操作；最後 %d 秒什麼都不要做", duration, runTail), 6)

    task.delay(duration, function()
        if recording and runId == id then
            finish("時間到")
        end
    end)
end

