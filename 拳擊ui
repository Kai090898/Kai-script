-- ====================================================================
--  拳擊模擬器探測器（有介面版）：只讀取、只記錄，不會修改遊戲
--  記錄三件事：
--   1. 遊戲有哪些介面和 Remote（伺服器溝通用的通道）
--   2. 你手動操作時，遊戲實際送出了哪些 Remote、帶什麼參數
--   3. 開蛋動畫結束後，還有哪些物件殘留在畫面上（造成卡頓的原因）
--  結果自動複製到剪貼簿，也存成 KaiPunchProbe.txt
--
--  用法：打開介面 →「錄製」分頁設定秒數 → 按「開始錄製」，
--        然後照「要做的事」分頁一項一項操作，最後幾秒什麼都不要做。
-- ====================================================================
-- ===== 進度提示（畫面上方中間；不依賴介面庫，用來確認腳本有沒有真的在跑）=====
local __stageGui, __stageLabel
local function __stage(text)
    print("[" .. text .. "]")  -- 也印到主控台的 Log，畫面上看不到時可以在那裡找
    pcall(function()
        if not __stageGui or not __stageGui.Parent then
            __stageGui = Instance.new("ScreenGui")
            __stageGui.Name = "KaiProbeStage"
            __stageGui.ResetOnSpawn = false
            __stageGui.IgnoreGuiInset = true
            __stageGui.DisplayOrder = 998
            local ok = pcall(function()
                __stageGui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
            end)
            if not ok or not __stageGui.Parent then
                __stageGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
            end
            local frame = Instance.new("Frame")
            frame.Size = UDim2.fromOffset(330, 30)
            frame.AnchorPoint = Vector2.new(0.5, 0)
            frame.Position = UDim2.new(0.5, 0, 0, 130)
            frame.BackgroundColor3 = Color3.new(0, 0, 0)
            frame.BackgroundTransparency = 0.15
            frame.Parent = __stageGui
            __stageLabel = Instance.new("TextLabel")
            __stageLabel.Size = UDim2.new(1, -12, 1, 0)
            __stageLabel.Position = UDim2.fromOffset(6, 0)
            __stageLabel.BackgroundTransparency = 1
            __stageLabel.TextColor3 = Color3.new(1, 1, 1)
            __stageLabel.TextXAlignment = Enum.TextXAlignment.Left
            __stageLabel.TextSize = 14
            __stageLabel.Font = Enum.Font.GothamMedium
            __stageLabel.Parent = frame
        end
        __stageLabel.Text = text
    end)
end

