for i, name in ipairs(TASKS) do
    taskDone[i] = false
    taskToggles[i] = TaskTab:CreateToggle({
        Name = name,
        CurrentValue = false,
        Callback = function(v)
            taskDone[i] = v and true or false
        end,
    })
end

TaskTab:CreateSection("最後")

TaskTab:CreateButton({
    Name = "最後的 N 秒：什麼都不要做（N 在「錄製」分頁設定）",
    Callback = function() end,
})

TaskTab:CreateButton({
    Name = "全部取消打勾",
    Callback = function()
        for i = 1, #TASKS do
            pcall(function() taskToggles[i]:Set(false) end)
        end
    end,
})

-- ===== 狀態顯示（倒數 + 下一步提示）=====
task.spawn(function()
    while alive do
        if recording then
            local left = math.max(math.ceil(endAt - tick()), 0)
            local inTail = left <= runTail

            if inTail and not tailNotified then
                tailNotified = true
                notify("最後 " .. runTail .. " 秒", "請什麼都不要做，等殘留的動畫物件顯示出來", 6)
            end

            setName(statusBtn, string.format("錄製中｜剩 %d 秒%s", left, inTail and "｜現在不要操作" or ""))

            if inTail then
                setName(hintBtn, "最後階段：什麼都不要做，等它結束")
            else
                local i = nextTaskIndex()
                if i then
                    setName(hintBtn, "下一步：" .. TASKS[i] .. "（做完點我打勾）")
                else
                    setName(hintBtn, "所有項目都做完了，等時間到或按「停止並輸出」")
                end
            end
        else
            setName(statusBtn, lastReport and "狀態：待機中（上次結果已輸出）" or "狀態：待機中")
            setName(hintBtn, "按下「開始錄製」後照順序操作")
        end
        task.wait(0.3)
    end
end)

