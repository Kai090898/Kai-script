EquipTab:CreateSection("合成裝備（3 件同名同稀有度 → 1 件高一級）")
do
    -- 診斷時看過：
    --   送出  Events.PlayerMergeEquipment:FireServer({"937", "1012", "940"})   （三件裝備的編號，字串）
    --   收到  GenerateEquipment（伺服器傳整個背包：編號 = {name, rarity, equipped}）
    -- 稀有度由低到高。Common / Rare / Legendary / Mythic 是看過的字串，Epic 是你確認過的，
    -- Secret 是猜的（合成介面上顯示 ???），所以放在最後當試驗。
    local LADDER = {"Common", "Rare", "Epic", "Legendary", "Mythic", "Secret"}
    local RANK = {}
    for i, n in ipairs(LADDER) do
        RANK[n:lower()] = i
    end

    -- 名稱比對：去掉空白、符號、大小寫（Golden Clover = GoldenClover）
    local function norm(s)
        return (tostring(s or ""):lower():gsub("[^%w]", ""))
    end

    -- ===== 取得背包 =====
    -- 1) 優先用伺服器傳來的 GenerateEquipment（之後每次合成伺服器都會再傳一次最新的）
    -- 2) 載入腳本後還沒收過的話，用 getgc 在記憶體裡找遊戲自己存的背包表
    local inv, invSource, gcAt = nil, "無", 0
    local hookedEvent = false

    local function looksLikeInv(t)
        if type(t) ~= "table" then return false end
        local seen = 0
        for _, v in pairs(t) do
            seen += 1
            if type(v) == "table" and type(v.name) == "string" and type(v.rarity) == "string" then
                return true
            end
            if seen >= 8 then break end
        end
        return false
    end

    local function hookInventoryEvent()
        if hookedEvent then return end
        for _, r in ipairs(RS:GetDescendants()) do
            if r:IsA("RemoteEvent") and r.Name == "GenerateEquipment" then
                hookedEvent = true
                r.OnClientEvent:Connect(function(tbl)
                    if looksLikeInv(tbl) then
                        inv = tbl
                        invSource = "伺服器"
                    end
                end)
                return
            end
        end
    end
    hookInventoryEvent()

    local function countKeys(t)
        local n = 0
        for _ in pairs(t) do n += 1 end
        return n
    end

    local function scanGc()
        if not getgc then return nil end
        local ok, list = pcall(getgc, true)
        if not ok or type(list) ~= "table" then return nil end
        local best, bestGood = nil, 0
        for _, t in ipairs(list) do
            if type(t) == "table" then
                local good, total = 0, 0
                for _, v in next, t do
                    total += 1
                    if type(v) == "table" then
                        local nm, rr = rawget(v, "name"), rawget(v, "rarity")
                        if type(nm) == "string" and type(rr) == "string" then
                            good += 1
                        end
                    end
                    if total > 4000 then break end
                end
                if good >= 5 and good >= total * 0.8 and good > bestGood then
                    best, bestGood = t, good
                end
            end
        end
        return best
    end

    local function currentInv(force)
        hookInventoryEvent()
        if invSource == "伺服器" and not force then
            return inv
        end
        if force or invSource ~= "伺服器" then
            if force or tick() - gcAt > 2 then
                gcAt = tick()
                local t = scanGc()
                if t and (not inv or invSource ~= "伺服器" or countKeys(t) >= countKeys(inv)) then
                    inv = t
                    invSource = "記憶體"
                end
            end
        end
        return inv
    end

    -- ===== 設定 =====
    local iNames = EquipTab:CreateInput({
        Name = "要合成的裝備名稱（用逗號分開，輸入 全部 代表所有）",
        PlaceholderText = "例如 GoldenClover, Dagger（先按下面的按鈕看背包有哪些）",
        Callback = function(text)
            T.equipNames = tostring(text or "")
            notify("已設定", "裝備 = " .. T.equipNames)
        end,
    })
    regText("equipNames", iNames, function() return T.equipNames end, function(v) T.equipNames = v end)

    local dTarget = EquipTab:CreateDropdown({
        Name = "合成到哪個稀有度（低於這個的才會被合成）",
        Options = {"Rare", "Epic", "Legendary", "Mythic", "Secret"},
        CurrentOption = {T.equipTarget},
        Callback = function(opt)
            T.equipTarget = type(opt) == "table" and opt[1] or opt
        end,
    })
    regDropdown("equipTarget", dTarget, function() return T.equipTarget end, function(v) T.equipTarget = v end)

    addNumber(EquipTab, "每一輪送出幾組（3 件一組）", "預設 3", "equipBatch", 1)
    addNumber(EquipTab, "每一輪間隔（秒）", "預設 0.6", "equipDelay", 0.2)

    EquipTab:CreateButton({
        Name = "讀取背包（複製各裝備的數量）",
        Callback = function()
            local t = currentInv(true)
            if not t then
                notify("讀不到背包", "先手動開一次「裝備」或合成一件，讓遊戲傳一次背包再試", 8)
                return
            end
            local count, total = {}, 0
            for _, info in pairs(t) do
                if type(info) == "table" and type(info.name) == "string" then
                    total += 1
                    local key = info.name .. "｜" .. tostring(info.rarity)
                    local c = count[key] or {n = 0, worn = 0}
                    c.n += 1
                    if info.equipped then c.worn += 1 end
                    count[key] = c
                end
            end
            local lines = {}
            for k, c in pairs(count) do
                table.insert(lines, string.format("%s ×%d（穿著 %d）", k, c.n, c.worn))
            end
            table.sort(lines)
            local text = table.concat(lines, "\n")
            if setclipboard then pcall(setclipboard, text) end
            notify("背包", string.format("共 %d 件（來源：%s），名單已複製", total, invSource), 6)
        end,
    })

    -- ===== 合成 =====
    local function parseWanted()
        local text = T.equipNames or ""
        if text:find("全部") or text:lower():find("all") then
            return nil
        end
        local set, any = {}, false
        for piece in text:gmatch("[^,，、;；\n]+") do
            local k = norm(piece)
            if k ~= "" then
                set[k] = true
                any = true
            end
        end
        return any and set or nil
    end

    local warnedRarity = {}
    -- 找出這一輪可以合成的組合：先合低稀有度，每組是同名、同稀有度、沒穿著的 3 件
    local function planMerges(t, wanted, targetRank, pending, failed, maxGroups)
        local groups = {}
        for id, info in pairs(t) do
            if type(info) == "table" and type(info.name) == "string" and type(info.rarity) == "string" then
                local sid = tostring(id)
                local r = RANK[info.rarity:lower()]
                if not r then
                    if not warnedRarity[info.rarity] then
                        warnedRarity[info.rarity] = true
                        blog("不認識的稀有度：" .. info.rarity .. "（已略過）")
                    end
                elseif r < targetRank
                    and not info.equipped and not info.locked and not info.favorite
                    and not pending[sid] and (failed[sid] or 0) < 2
                    and (wanted == nil or wanted[norm(info.name)]) then
                    groups[r] = groups[r] or {}
                    groups[r][info.name] = groups[r][info.name] or {}
                    table.insert(groups[r][info.name], sid)
                end
            end
        end
        local plan = {}
        for r = 1, targetRank - 1 do
            if groups[r] then
                for name, ids in pairs(groups[r]) do
                    table.sort(ids, function(a, b)
                        return (tonumber(a) or 0) < (tonumber(b) or 0)
                    end)
                    while #ids >= 3 and #plan < maxGroups do
                        table.insert(plan, {
                            name = name,
                            rank = r,
                            ids = {table.remove(ids, 1), table.remove(ids, 1), table.remove(ids, 1)},
                        })
                    end
                end
            end
            if #plan >= maxGroups then break end
        end
        return plan
    end

    local function runMerge()
        if (T.equipNames or "") == "" then
            notify("還沒選裝備", "請先輸入裝備名稱（或輸入 全部）", 6)
            return
        end
        local wanted = parseWanted()
        local targetRank = RANK[(T.equipTarget or "Mythic"):lower()] or 5
        if not currentInv(true) then
            notify("讀不到背包", "先手動開一次「裝備」或合成一件，讓遊戲傳一次背包再試", 8)
            return
        end
        blog("合成裝備開始：背包來源 " .. invSource .. "，目標 " .. LADDER[targetRank])

        local pending, failed = {}, {}
        local fired, idle = 0, 0
        local batch = math.clamp(math.floor(N.equipBatch), 1, 20)

        while S.autoEquipMerge and fired < 600 do
            local t = currentInv(false)
            if not t then break end

            -- 已經從背包消失 = 伺服器處理完了；太久沒消失 = 這組可能失敗
            local now = tick()
            for sid, at in pairs(pending) do
                if t[sid] == nil and t[tonumber(sid)] == nil then
                    pending[sid] = nil
                elseif now - at > 6 then
                    pending[sid] = nil
                    failed[sid] = (failed[sid] or 0) + 1
                end
            end

            local plan = planMerges(t, wanted, targetRank, pending, failed, batch)
            if #plan > 0 then
                idle = 0
                for _, m in ipairs(plan) do
                    local ok, err = fire("PlayerMergeEquipment", m.ids)
                    if not ok then
                        status = "送出失敗：" .. tostring(err)
                        blog(status)
                        return
                    end
                    for _, sid in ipairs(m.ids) do
                        pending[sid] = tick()
                    end
                    fired += 1
                    status = string.format("合成 %s（%s → %s）第 %d 組", m.name, LADDER[m.rank], LADDER[m.rank + 1], fired)
                    task.wait(0.15)
                end
                task.wait(math.max(N.equipDelay, 0.2))
            elseif next(pending) then
                -- 還在等伺服器更新背包（合成出來的新裝備可能又能繼續合）
                idle += 1
                if idle > 24 then break end
                task.wait(0.5)
            else
                break
            end
        end
        status = string.format("裝備合成結束（共送出 %d 組）", fired)
        blog(status)
        notify("合成裝備", status, 5)
    end

    local merging = false
    local tEq
    tEq = EquipTab:CreateToggle({
        Name = "自動合成裝備（會消耗裝備，已穿著的不會動）",
        CurrentValue = false,
        Callback = function(v)
            S.autoEquipMerge = v
            if not v or merging then return end
            merging = true
            task.spawn(function()
                local ok, err = pcall(runMerge)
                if not ok then
                    status = "裝備合成出錯：" .. tostring(err)
                    blog(status)
                end
                merging = false
                S.autoEquipMerge = false
                pcall(function() tEq:Set(false) end)
            end)
        end,
    })
end

