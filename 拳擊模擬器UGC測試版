    -- 蛋的名稱：來自 workspace.EggVendors 底下的名字（探測時看過 Forest2、HalloweenEgg）
    local function listEggs()
        local names = {}
        local f = workspace:FindFirstChild("EggVendors")
        if f then
            for _, c in ipairs(f:GetChildren()) do
                if not table.find(names, c.Name) then
                    table.insert(names, c.Name)
                end
            end
        end
        table.sort(names, function(a,b)
            local an=tonumber(a:match("%d+")) or math.huge
            local bn=tonumber(b:match("%d+")) or math.huge
            if an~=bn then return an<bn end
            return a:lower()<b:lower()
        end)
        if #names == 0 then
