SetTab:CreateSection("效能與雜項")
do
    local afkConn
    local tAfk = addToggle(SetTab, "防掛機", "antiAfk", function(v)
        if afkConn then
            afkConn:Disconnect()
            afkConn = nil
        end
        if v then
            afkConn = LocalPlayer.Idled:Connect(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new())
            end)
        end
    end)
    regToggle("antiAfk", tAfk, function() return S.antiAfk end)

    local t3d = addToggle(SetTab, "關閉 3D 渲染（省電、省效能，畫面會變黑）", "no3d", function(v)
        pcall(function() RunService:Set3dRenderingEnabled(not v) end)
    end)

    local fogBackup
    local tFog = addToggle(SetTab, "去除霧", "noFog", function(v)
        if v then
            fogBackup = fogBackup or {Lighting.FogStart, Lighting.FogEnd}
            Lighting.FogStart = 1e8
            Lighting.FogEnd = 1e9
            for _, d in ipairs(Lighting:GetChildren()) do
                if d:IsA("Atmosphere") then d.Density = 0 end
            end
        elseif fogBackup then
            Lighting.FogStart, Lighting.FogEnd = fogBackup[1], fogBackup[2]
        end
    end)

    local tLow = addToggle(SetTab, "低畫質", "lowQuality", function(v)
        pcall(function()
            settings().Rendering.QualityLevel = v and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
        end)
    end)

    SetTab:CreateButton({
        Name = "重生角色",
        Callback = function()
            local hum = getHumanoid()
            if hum then hum.Health = 0 end
        end,
    })
end

