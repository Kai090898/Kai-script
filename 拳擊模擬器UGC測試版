            local btn = findOpenButton(T.hatchMode == "Open3" and "Open3" or "Open1")
            if btn then
                click(btn)
                used = true
                hatchStats.button += 1
            end
        end
        if not used then
            local ok, err = fire("PlayerPressedKeyOnEgg", egg)
            if ok then
                hatchStats.sent += 1
            else
                hatchStats.failed += 1
                blog("孵蛋事件送出失敗：" .. tostring(err))
            end
        end
        hatchStats.attempts += 1
        hatchCount += 1
        status = string.format("已嘗試孵蛋 %d 次（%s，%s）", hatchCount, egg, used and "按鈕" or "事件")
        if S.instantOpen or fastHide then
            if not fastHide then task.wait(0.15) end
            for _, n in ipairs({"PetOpenUI", "PetOpenUIOLD"}) do
                local g = dig(getPg(), n)
                if g then g.Enabled = false end
            end
        end
    end
    every("hatch", function() return N.hatchDelay end, hatchOnce)
end

EggTab:CreateSection("開蛋動畫（避免越開越卡）")
do
    local removed = 0

    -- 一、介面：PlayerGui 的 PetOpenUI。記下原本就有的東西，之後新長出來的過一陣子就清掉
    local baseline = {}
    local born = {}
    local hooked = {}

    local function hookUI(g)
        if hooked[g] then return end
        hooked[g] = true
        for _, d in ipairs(g:GetDescendants()) do
            baseline[d] = true
        end
        g.DescendantAdded:Connect(function(d)
            if not baseline[d] then
                born[d] = tick()
            end
        end)
        g.AncestryChanged:Connect(function()
            if not g.Parent then hooked[g] = nil end
        end)
    end

    local function hookAll()
        for _, n in ipairs({"PetOpenUI", "PetOpenUIOLD"}) do
            local g = dig(getPg(), n)
            if g then hookUI(g) end
        end
    end
    hookAll()

    local function cleanUI(maxAge)
        hookAll()
        local now = tick()
        for d, t in pairs(born) do
            if not d.Parent then
                born[d] = nil
            elseif now - t >= maxAge then
                born[d] = nil
                pcall(function() d:Destroy() end)
                removed += 1
            end
        end
    end

    -- 二、3D 模型：Workspace.Camera.EggOpenMap.PetOpeningModels
    -- 診斷結果：每次開蛋，遊戲會在這裡複製出寵物模型（一次大約 260 個物件），
    -- 開太快時遊戲來不及清，就會一直留在畫面上。
    -- 載入腳本時就已經在裡面的東西會被保護起來（可能是遊戲自己要用的樣板），
    -- 只清腳本載入之後新長出來的。
    local function openingFolder()
        local cam = workspace.CurrentCamera or workspace:FindFirstChild("Camera")
        local map = cam and cam:FindFirstChild("EggOpenMap")
        return map and map:FindFirstChild("PetOpeningModels")
    end

    local modelBase = {}
    local modelBorn = {}
    do
        local f = openingFolder()
        if f then
            for _, c in ipairs(f:GetChildren()) do
                modelBase[c] = true
            end
        end
    end

    local function cleanModels(maxAge)
        local f = openingFolder()
        if not f then return end
        local now = tick()
        for _, c in ipairs(f:GetChildren()) do
            if not modelBase[c] then
                local t = modelBorn[c]
                if not t then
                    t = now
                    modelBorn[c] = t
                end
                if now - t >= maxAge then
                    modelBorn[c] = nil
                    pcall(function() c:Destroy() end)
                    removed += 1
                end
            end
        end
        for c in pairs(modelBorn) do
            if not c.Parent then modelBorn[c] = nil end
        end
    end

    local function clean(maxAge)
        cleanUI(maxAge)
        cleanModels(maxAge)
    end

    addToggle(EggTab, "清除開蛋動畫殘留", "cleanHatch")
    addNumber(EggTab, "動畫保留幾秒後清除", "預設 3，越小越乾淨，但太小會把正在播的動畫弄壞", "cleanAge", 0.5)
    addToggle(EggTab, "瞬間開蛋（開完立刻關掉開蛋畫面）", "instantOpen")
    every("cleanHatch", function() return 0.5 end, function()
        clean(N.cleanAge)
    end)

    EggTab:CreateButton({
        Name = "立刻清除全部殘留",
        Callback = function()
            clean(0)
            notify("開蛋動畫", "已清除，累計清掉 " .. removed .. " 個物件", 4)
        end,
    })
end

