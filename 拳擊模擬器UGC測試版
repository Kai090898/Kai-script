local function openUGCQuest()
    local pg=LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then notify("今日 UGC","找不到遊戲介面",4);return end
    -- 優先使用先前玩家打開過的任務頁；未記錄時使用已確認的 SummerQuest
    local root=ugcLastOpened and ugcLastOpened.Parent and ugcLastOpened
        or pg:FindFirstChild("SummerQuest")
    if not root then
        notify("今日 UGC","尚未找到任務頁，請先使用遊戲的 UGC 按鈕開啟一次",6)
        return
    end
    if root:IsA("ScreenGui") then root.Enabled=true end
    local main=root:FindFirstChild("Main",true)
    if main and main:IsA("GuiObject") then main.Visible=true end
    local visibleAny=false
    for _,obj in ipairs(root:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.Visible then visibleAny=true;break end
    end
    if not visibleAny then
        local first=root:FindFirstChildWhichIsA("Frame",true)
        if first then first.Visible=true end
    end
    ugcLastOpened=root
    notify("今日 UGC","已嘗試開啟遊戲原生任務視窗",4)
end
UGCTab:CreateButton({Name="開啟 UGC 任務介面",Callback=openUGCQuest})
UGCTab:CreateSection("目前快捷目標：SummerQuest；若今日任務換介面，需重新確認")

-- ====================================================================
--  傳送
-- ====================================================================
TpTab:CreateSection("傳送到世界")
do
    -- TeleportEvent:InvokeServer("Teleport", 世界編號)（探測時看過 1、5、8）
    local opts = {}
    for i = 1, 12 do
        table.insert(opts, tostring(i))
    end
    local dTp = TpTab:CreateDropdown({
        Name = "選擇世界編號",
        Options = opts,
        CurrentOption = {T.teleport},
        Callback = function(opt)
            T.teleport = type(opt) == "table" and opt[1] or opt
        end,
    })
    regDropdown("teleport", dTp, function() return T.teleport end, function(v) T.teleport = v end)

    TpTab:CreateButton({
        Name = "傳送",
        Callback = function()
            local n = tonumber(T.teleport)
            if not n then return end
            local ok, res = invoke("TeleportEvent", "Teleport", n)
            blog("傳送 " .. n .. "：" .. tostring(ok) .. " " .. tostring(res))
            notify("傳送", ok and ("已送出傳送到 " .. n) or ("失敗：" .. tostring(res)), 4)
        end,
    })
end

