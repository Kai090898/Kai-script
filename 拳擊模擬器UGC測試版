local function hatchStatsText()
    local elapsed = math.max(os.clock() - hatchStats.start, 1)
    return string.format("嘗試 %d | 事件送出 %d | 失敗 %d | 按鈕 %d | %.1f 次/分鐘",
        hatchStats.attempts, hatchStats.sent, hatchStats.failed, hatchStats.button,
