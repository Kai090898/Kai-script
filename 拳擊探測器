    lbl.TextSize = 10
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.Parent = scrollParent

    local function syncHeight()
        local h = math.max(120, lbl.TextBounds.Y + 20)
        lbl.Size = UDim2.new(1, -6, 0, h)
        scrollParent.CanvasSize = UDim2.new(0, 0, 0, h + 14)
