-- ===== 4. 監聽送出的 Remote（完全非同步，不修改 namecall 狀態）=====
local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then
        return '"' .. string.sub(v, 1, 60) .. '"'
    elseif t == "table" then
        if d >= 2 then return "{…}" end
        local parts, c = {}, 0
        for k, x in pairs(v) do
            c += 1
            if c > 8 then
                table.insert(parts, "…")
                break
            end
            table.insert(parts, tostring(k) .. "=" .. ser(x, d + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    elseif t == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return "<" .. (ok and name or "?") .. ">"
    end
    return tostring(v)
end

local function record(remote, method, args)
    if not isRunning or isSpyPaused then return end
    local key = remote:GetFullName()
    local e = calls[key]
    if not e then
        e = {cls = remote.ClassName, method = method, count = 0, samples = {}, first = tick() - t0}
        calls[key] = e
        uniqueRemoteCount += 1
    end
    e.count += 1
    totalCallCount += 1

    local parts = {}
    for i = 1, args.n do
        parts[i] = ser(args[i])
    end
    local s = table.concat(parts, ", ")

    table.insert(recentFeed, 1, string.format("[%.0fs] %s(%s)", tick() - t0, remote.Name, string.sub(s, 1, 55)))
    if #recentFeed > 16 then
        table.remove(recentFeed)
    end

    if #e.samples < 4 then
        for _, x in ipairs(e.samples) do
            if x == s then return end
        end
        table.insert(e.samples, s)
    end
end

local spyOn = false
local hookStatusNote = ""
if hookmetamethod and getnamecallmethod and newcclosure then
    local ok, err = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if isRunning and not isSpyPaused and (m == "FireServer" or m == "InvokeServer") and not (checkcaller and checkcaller()) then
                if typeof(self) == "Instance" then
                    local cls = self.ClassName
                    if cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent" then
                        local packed = { ... }
                        packed.n = select("#", ...)
                        task.spawn(pcall, record, self, m, packed)
                    end
                end
                if setnamecallmethod then
                    setnamecallmethod(m)
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then
        spyOn = true
    else
        hookStatusNote = " (Hook失敗)"
        log("\n（掛載 hookmetamethod 失敗：" .. tostring(err) .. "）")
    end
else
    hookStatusNote = " (不支援Hook)"
    log("\n（這個執行器不支援 hookmetamethod，沒辦法監聽送出的 Remote）")
end

-- ===== 5. 追蹤新出現的物件（排除探測器自己的 UI）=====
local function track(root, label)
    if not root then return end
    local conn = root.DescendantAdded:Connect(function(d)
        if not isRunning then return end
        if rootContainer and (d == rootContainer or d:IsDescendantOf(rootContainer)) then return end
        born[d] = {t = tick(), label = label}
        trackedCount += 1
    end)
    table.insert(connections, conn)
end

