-- UGC 原生按鈕診斷：只觀察玩家操作
local pg=game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local lines={"UGC 按鈕診斷：請手動開啟、關閉、再次開啟任務"}
local connections={}
local function log(s)
    table.insert(lines,s)
    print(s)
end
local function watch(o)
    if o:IsA("GuiButton") then
        table.insert(connections,o.Activated:Connect(function()
            log("點擊："..o:GetFullName())
        end))
    end
    if o:IsA("ScreenGui") then
        table.insert(connections,o:GetPropertyChangedSignal("Enabled"):Connect(function()
            log("介面："..o:GetFullName().." Enabled="..tostring(o.Enabled))
        end))
    end
end
for _,o in ipairs(pg:GetDescendants()) do watch(o) end
table.insert(connections,pg.DescendantAdded:Connect(watch))
print("請在 30 秒內手動開關 UGC 任務兩次")
task.wait(30)
for _,c in ipairs(connections) do c:Disconnect() end
local report=table.concat(lines,"\n")
print(report)
if setclipboard then pcall(setclipboard,report) end
