local function finalizeProbe()
    if isFinished then return end
    isFinished = true
    isRunning = false

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end

    if spyOn then
        log("\n===== 你操作時送出的 Remote（次數多的在前）=====")
        local list = {}
        for key, e in pairs(calls) do
            table.insert(list, {key = key, e = e})
        end
        table.sort(list, function(a, b) return a.e.count > b.e.count end)
        for i, it in ipairs(list) do
            if i > 70 then break end
            log(string.format("\n%s [%s:%s] 共%d次 首次在%.0f秒", it.key, it.e.cls, it.e.method, it.e.count, it.e.first))
            for _, s in ipairs(it.e.samples) do
                log("   參數：" .. s)
            end
        end
    end

    log("\n===== 存活超過 8 秒的新物件（數量多的在前）=====")
    local groups = {}
    local now = tick()
    for d, info in pairs(born) do
        if now - info.t > 8 and d:IsDescendantOf(game) then
            local ok, full = pcall(function() return d:GetFullName() end)
            if ok then
                local key = info.label .. "｜" .. full:gsub("%d+", "#") .. " [" .. d.ClassName .. "]"
                groups[key] = (groups[key] or 0) + 1
            end
        end
    end

    local gl = {}
    for k, c in pairs(groups) do
        table.insert(gl, {k = k, c = c})
    end
    table.sort(gl, function(a, b) return a.c > b.c end)
    for i, g in ipairs(gl) do
        if i > 45 then break end
        log(string.format("%d × %s", g.c, g.k))
    end

    finalReportText = table.concat(out, "\n")
    if setclipboard then pcall(setclipboard, finalReportText) end
    if writefile then pcall(writefile, "KaiPunchProbe.txt", finalReportText) end

    timerLabel.Text = "✔ 完成！已複製並存檔 KaiPunchProbe.txt"
    timerLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
    barFill.Size = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(100, 180, 255)

    finishBtn.Text = "已完成匯出"
    finishBtn.BackgroundColor3 = Color3.fromRGB(60, 70, 90)
    copyBtn.BackgroundColor3 = Color3.fromRGB(58, 115, 205)

    reportText.Text = finalReportText:sub(1, 3500) .. (#finalReportText > 3500 and "\n\n...（完整內容已複製到剪貼簿與 KaiPunchProbe.txt）" or "")
    setActiveTab("report")

    print("[拳擊探測器] 完成，已複製到剪貼簿")
end

finishBtn.MouseButton1Click:Connect(function()
    finalizeProbe()
end)

copyBtn.MouseButton1Click:Connect(function()
    local textToCopy = isFinished and finalReportText or table.concat(out, "\n")
    if setclipboard then
        local ok = pcall(setclipboard, textToCopy)
        copyBtn.Text = ok and "已複製 ✔" or "複製失敗"
        task.delay(1.5, function()
            if copyBtn and copyBtn.Parent then
                copyBtn.Text = "複製結果"
            end
        end)
    else
        copyBtn.Text = "不支援剪貼簿"
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    isRunning = false
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    if rootContainer then
        pcall(function() rootContainer:Destroy() end)
    end
end)

-- ===== 7. 倒數計時與即時畫面更新 =====
task.spawn(function()
    while isRunning and mainFrame.Parent do
        local elapsed = tick() - t0
        local remaining = math.max(0, DURATION - elapsed)
        local ratio = math.clamp(remaining / DURATION, 0, 1)

        if remaining <= LAST_WAIT then
            timerLabel.Text = string.format("⏳ 請勿操作（偵測殘留中）｜剩餘 %.0f 秒", remaining)
            timerLabel.TextColor3 = Color3.fromRGB(255, 196, 86)
            barFill.BackgroundColor3 = Color3.fromRGB(255, 180, 65)
        else
            timerLabel.Text = string.format("● 探測中｜剩餘 %.0f 秒", remaining)
            timerLabel.TextColor3 = Color3.fromRGB(96, 215, 148)
            barFill.BackgroundColor3 = Color3.fromRGB(78, 185, 130)
        end

        barFill.Size = UDim2.new(ratio, 0, 1, 0)
        statsLabel.Text = string.format(
            "Remote: %d 種 (%d 次) ｜ 物件: %d%s",
            uniqueRemoteCount,
            totalCallCount,
            trackedCount,
            hookStatusNote
        )

        if not isFinished and #recentFeed > 0 and feedScroll.Visible then
            feedText.Text = table.concat(recentFeed, "\n")
        end

        if remaining <= 0 then
            finalizeProbe()
            break
        end
        task.wait(0.25)
    end
end)

